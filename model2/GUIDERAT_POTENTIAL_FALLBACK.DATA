------------------------------------------------------------------------------------------------

--
NEWTRAN

--
GRIDFILE
0  1/

--
GRIDUNIT
METRES  /

--
INIT


--
PINCH
 0.001   GAP  1*   TOPBOT   ALL /

MINPVV
 1144*100 2002*300 /



INCLUDE
 'include/mod2a_13x22x11.grdecl' /

INCLUDE
 'include/fluxmun.grdecl' /


INCLUDE
 'include/faults.grdecl' /


INCLUDE
 'include/poro.grdecl' /

