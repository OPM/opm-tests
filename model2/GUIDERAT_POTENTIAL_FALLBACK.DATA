-- -----------------------------------------------------------------------------
-- Fast variant of model2 to verify potentials are used when sum(guiderates) = 0
-- Proper fall-back ensures the production target of group RES is not exceeded.
-- -----------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
RUNSPEC
------------------------------------------------------------------------------------------------


DIMENS
 13 22 11 /


OIL
WATER
GAS
DISGAS

VFPPDIMS
--max.rate  max.THP   max.fw   max.fg   max.ALQ    max.tabs
  40        20        20       20        13         60      /

METRIC

START
 01  'NOV' 2018 /

--
GRIDOPTS
 'YES'	      0 / 

EQLDIMS
 2 1*  25 /


EQLOPTS
 THPRES  /   


REGDIMS
-- max. ntfip  nmfipr  max. nrfreg   max. ntfreg
   2          1       1*            2    /

--
WELLDIMS
--max.well  max.con/well  max.grup  max.w/grup
 10	    15 	          8	     10   /


WSEGDIMS
-- nswlmx  nsegmx  nlbrmx
  10       20     1 /


--
TABDIMS
--ntsfun     ntpvt  max.nssfun  max.nppvt  max.ntfip  max.nrpvt
  10          1      50          60         2         60 /

--
FAULTDIM
120 / max. number os fault segments

UNIFIN
UNIFOUT

