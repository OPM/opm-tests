------------------------------------------------------------------------------------------------
SCHEDULE
------------------------------------------------------------------------------------------------

TUNING
 1* 1 /
/
/


RPTRST
 'BASIC=2' /
  
--   			      FIELD
--   				|
--   			       RES
--   		     -----------+-------------------
--   		    |			                  |	      
--   		  PROD  		                 INJE     
--           ---+------------+                |
--            PRODA        PRODB              |
--              |            |                |
--   	     +-----+------+------+            +----+----+ 
--   	     |     |	  |      |            |	        |  
--   	  PROD1  PROD2  PROD3  PROD4        INJ1      INJ2

GRUPTREE
   'RES'     'FIELD' /
   'INJE'     'RES'  /
   'PROD'     'RES'  /
   'PRODA'    'PROD'  /
   'PRODB'    'PROD'  /
/


GCONPROD
 'RES'   GRAT  10000 12000 0.4E6  15000 RATE  'NO'  9* /
/

-- Check guide rate fall-back to potentials
--
--   A = 0.5, B = 1, C = D = E = F = 0   =>   guide rate = sqrt(oil potential)
--
-- Since there is no oil in the model, guide rate sums should be zero and fall back to 
-- gas potentials ensures the target is reached and not exceeded. 
GUIDERAT
  0.0 'OIL' 0.5 1 /

GCONINJE
 'RES'      'WATER'  'VREP'  3*   1.25  /
 'RES'      'GAS'    'REIN'  2*   1.0  /
/ 

WELSPECS
-- Well    Grp      I  J  RefDepth  Type  DrainRad  GasInEq  AutoShut  XFlow  FluidPVT  HydSDens  FluidInPlReg
  'PROD1'  'PRODA'  6  3     1*      OIL    0.0       STD      SHUT      YES    0         SEG       0 /
  'PROD3'  'PRODB'  11  19   1*      OIL    0.0       STD      SHUT      YES    0         SEG       0 /
  'PROD4'  'PRODB'  11  6    1*      OIL    0.0       STD      SHUT      YES    0         SEG       0 /
  'PROD2'  'PRODA'  10  4    1*      OIL    0.0       STD      SHUT      YES    0         SEG       0 /
  'INJ1'   'INJE'	2  13    1*      GAS    0.0	      STD	   SHUT      YES    0	      SEG       0 /
  'INJ2'   'INJE'  12  20    1*     WATER   0.0       STD      SHUT      YES    0         SEG       0 /
/

INCLUDE
 './include/prod1_compl.inc' /
INCLUDE
 './include/prod2_compl.inc' /
INCLUDE
 './include/prod3_compl.inc' /
INCLUDE
 './include/prod4_compl.inc' /

INCLUDE
 './include/inj1_compl.inc' /
INCLUDE
 './include/inj2_compl.inc' /


WCONPROD
-- WellN  Status  CtrlMode  Qo    Qw     Qg     Qliq    Qresv   bhp   
 'PROD1'  'OPEN'  'GRUP'  4000.0    1*  4.0E6    8000.0    1*    60.0  / 
 'PROD2'  'OPEN'  'GRUP'  4000.0    1*  4.0E6    8000.0    1*    60.0  / 
 'PROD3'  'OPEN'  'GRUP'  4000.0    1*  4.0E6    8000.0    1*    60.0  / 
 'PROD4'  'OPEN'  'GRUP'  4000.0    1*  4.0E6    8000.0    1*    60.0  / 
/

WCONINJE
-- WellN  Type    Status  CtrlMode   SurfRate  ResVol   bhp    
 'INJ1'   'GAS'   'OPEN'    'RATE'      1.6E6    1*     500.0    / 
 'INJ2'   'WATER' 'OPEN'    'RATE'     8000.0    1*     500.0    / 
/

TSTEP
  10*1 /

END

