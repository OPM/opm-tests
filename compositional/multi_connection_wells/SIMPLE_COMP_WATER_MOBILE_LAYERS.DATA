-- CO2 injection into three 5 m layers of 30 cells, of 50, 100 and 200 mD,
-- with a vertical permeability of 10 mD. Both wells are vertical with a
-- connection in every layer. Their bottom-hole pressure refers to the centre
-- of the top layer, so the deeper connections see the hydrostatic head of the
-- wellbore fluid. Initial water saturation is 0.5 (krw = 0.105). Both wells
-- use bottom-hole pressure control. The schedule spans 50 days in 36 report
-- steps.
------------------------------------------------------------------------
RUNSPEC
------------------------------------------------------------------------
TITLE
   SIMPLE CO2 INJECTION WITH MOBILE WATER IN THREE LAYERS

METRIC

TABDIMS
/
OIL
GAS
WATER
DIMENS
30 1 3
/

COMPS
3 /

FULLIMP

WELLDIMS
2 3 1* 2/

START
  1 'JAN' 2016  /

REGDIMS
1 1 0 0 /

UNIFIN
UNIFOUT

------------------------------------------------------------------------
GRID
------------------------------------------------------------------------
INCLUDE
 'include/GRID_LAYERS.inc' /


------------------------------------------------------------------------
PROPS
------------------------------------------------------------------------
INCLUDE
 'include/PROPS.inc' /


------------------------------------------------------------------------
SOLUTION
------------------------------------------------------------------------

PRESSURE
90*75.
/

SGAS
90*0.5
/

SWAT
90*0.5
/

TEMPI
90*150
/

ZMF
90*0.1
90*0.3
90*0.6
/

------------------------------------------------------------------------
SUMMARY
------------------------------------------------------------------------
INCLUDE
 'include/SUMMARY.inc' /


------------------------------------------------------------------------
SCHEDULE
------------------------------------------------------------------------

INCLUDE
 'include/REPORTING.inc' /


WELSPECS
INJ  FIELD  1 1 2.5 GAS /
PROD FIELD 30 1 2.5 GAS /
/
COMPDAT
INJ   1 1 1 3 OPEN 2* 0.0151 /
PROD 30 1 1 3 OPEN 2* 0.0151 /
/

WELLSTRE
ISTR 1.0 0.0 0.0 /
/

WINJGAS
INJ STREAM ISTR /
/

WCONINJE
INJ GAS OPEN BHP 1e7 1* 150 /
/

WCONPROD
PROD OPEN BHP 2* 100000 2* 50 /
/

TSTEP
0.01 0.02 0.04 0.08 0.15 0.3 0.4
9*1.0
20*2.0
/
END
