0.8 0.60 0.60
0.99 0.70 0.70
/

STCOND
15.0 1.0 /

ROCK
    68.9476  0.0 /

PVTW
    75.0  1.03  4.0E-5  0.3  0.0 /

DENSITY
    800.0  1000.0  1.0 /

-- One table per equilibration region.
ZMFVD
 2000   0 0.7 0.3
 2100   0 0.3 0.7  /
 2000   0 0.7 0.3
 2100   0 0.3 0.7  /

RTEMP
100
/

------------------------------------------------------------------------
REGIONS
------------------------------------------------------------------------
EQLNUM
10*1 10*2
/

------------------------------------------------------------------------
SOLUTION
------------------------------------------------------------------------

-- The water-oil contact of each block lies three layers above its base.
EQUIL
   2010  250  2035  0  2000  0  /
   2060  155  2085  0  2050  0  /

-- Flow between the regions needs a potential difference above 50 bar.
THPRES
 1 2 50.0 /
/

------------------------------------------------------------------------
SUMMARY
------------------------------------------------------------------------
ALL

-- Block values at the top and the base of each block; layers 10 and 11 face
-- each other across the region boundary.
BPR
1 1 1 /
1 1 10 /
1 1 11 /
1 1 20 /
/

BGSAT
1 1 1 /
1 1 10 /
1 1 11 /
1 1 20 /
/

BOSAT
1 1 1 /
1 1 10 /
1 1 11 /
1 1 20 /
/

BWSAT
1 1 1 /
1 1 10 /
1 1 11 /
1 1 20 /
/

------------------------------------------------------------------------
SCHEDULE
------------------------------------------------------------------------
RPTRST
BASIC=1
PRESSURE
SGAS
SOIL
SWAT
XMF
YMF
ZMF
DENO
DENG
DENW
/

TSTEP
0.01 0.02 0.1 0.2 1.0 5.0
/
END
