-- CO2 injection into a 30-cell compositional row with one connection per
-- well. Initial water saturation is 0.5 (krw = 0.105), so the producer lifts
-- mobile water along with hydrocarbons. Both wells use bottom-hole pressure
-- control. The schedule spans 50 days in 36 report steps.
------------------------------------------------------------------------
RUNSPEC
------------------------------------------------------------------------
TITLE
   SIMPLE CO2 INJECTION WITH MOBILE WATER

METRIC

TABDIMS
/
OIL
GAS
WATER
DIMENS
30 1 1
/

COMPS
3 /

FULLIMP

WELLDIMS
2 2 1* 2/

START
  1 'JAN' 2016  /

REGDIMS
1 1 0 0 /

UNIFIN
UNIFOUT

------------------------------------------------------------------------
GRID
------------------------------------------------------------------------
INCLUDE
 'include/GRID.inc' /


------------------------------------------------------------------------
PROPS
------------------------------------------------------------------------
INCLUDE
 'include/PROPS.inc' /


------------------------------------------------------------------------
SOLUTION
------------------------------------------------------------------------

PRESSURE
30*75.
/

SGAS
30*0.5
/

SWAT
30*0.5
/

TEMPI
30*150
/

ZMF
30*0.1
30*0.3
30*0.6
/

------------------------------------------------------------------------
SUMMARY
------------------------------------------------------------------------
INCLUDE
 'include/SUMMARY.inc' /


------------------------------------------------------------------------
SCHEDULE
------------------------------------------------------------------------

INCLUDE
 'include/REPORTING.inc' /


WELSPECS
INJ  FIELD  1 1 1* GAS /
PROD FIELD 30 1 1* GAS /
/
COMPDAT
INJ   1 1 1 1 OPEN 2* 0.0151 /
PROD 30 1 1 1 OPEN 2* 0.0151 /
/

WELLSTRE
ISTR 1.0 0.0 0.0 /
/

WINJGAS
INJ STREAM ISTR /
/

WCONINJE
INJ GAS OPEN BHP 100000 1* 150 /
/

WCONPROD
PROD OPEN BHP 2* 100000 2* 50 /
/

TSTEP
0.01 0.02 0.04 0.08 0.15 0.3 0.4
9*1.0
20*2.0
/
END
