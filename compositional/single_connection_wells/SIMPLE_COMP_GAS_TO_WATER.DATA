-- A 30-cell compositional row with a gas injector and a producer at
-- opposite ends. Each well has one connection. The open injector runs on gas
-- for 20 days, then switches to water for 30 days. This tests preservation of
-- the gas already in the wellbore when the injection type changes. The 36
-- report steps show the well curves on both sides of the switch.
------------------------------------------------------------------------
RUNSPEC
------------------------------------------------------------------------
TITLE
   COMPOSITIONAL GAS TO WATER INJECTOR SWITCH

METRIC

TABDIMS
/
OIL
GAS
WATER
DIMENS
30 1 1
/

COMPS
3 /

FULLIMP

WELLDIMS
2 2 1* 2/

START
  1 'JAN' 2016  /

REGDIMS
1 1 0 0 /

UNIFIN
UNIFOUT

------------------------------------------------------------------------
GRID
------------------------------------------------------------------------
INCLUDE
 'include/GRID.inc' /


------------------------------------------------------------------------
PROPS
------------------------------------------------------------------------
INCLUDE
 'include/PROPS.inc' /


------------------------------------------------------------------------
SOLUTION
------------------------------------------------------------------------

PRESSURE
30*75.
/

SGAS
30*0.5
/

SWAT
30*0.5
/

TEMPI
30*150
/

ZMF
30*0.1
30*0.3
30*0.6
/

------------------------------------------------------------------------
SUMMARY
------------------------------------------------------------------------
INCLUDE
 'include/SUMMARY.inc' /


------------------------------------------------------------------------
SCHEDULE
------------------------------------------------------------------------

INCLUDE
 'include/REPORTING.inc' /


WELSPECS
INJ  FIELD  1 1 1* GAS /
PROD FIELD 30 1 1* GAS /
/
COMPDAT
INJ   1 1 1 1 OPEN 2* 0.0151 /
PROD 30 1 1 1 OPEN 2* 0.0151 /
/

WELLSTRE
ISTR 1.0 0.0 0.0 /
/

WINJGAS
INJ STREAM ISTR /
/

WCONINJE
INJ GAS OPEN BHP 100000 1* 150 /
/

WCONPROD
PROD OPEN BHP 2* 100000 2* 50 /
/

TSTEP
0.01 0.02 0.04 0.08 0.15 0.3 0.4
9*1.0
5*2.0
/
WCONINJE
INJ WATER OPEN RATE 0.4 1* 175 /
/
TSTEP
15*2.0
/
END
