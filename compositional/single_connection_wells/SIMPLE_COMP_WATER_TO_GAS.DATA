-- A water flood in a 30-cell compositional row with one connection per well.
-- After 100 days, the open water injector switches to gas for another 100
-- days. This tests preservation and displacement of the water already in the
-- wellbore. The 83 report steps show the well curves on both sides of the
-- switch.
------------------------------------------------------------------------
RUNSPEC
------------------------------------------------------------------------
TITLE
   COMPOSITIONAL WATER TO GAS INJECTOR SWITCH

METRIC

TABDIMS
/
OIL
GAS
WATER
DIMENS
30 1 1
/

COMPS
3 /

FULLIMP

WELLDIMS
2 2 1* 2/

START
  1 'JAN' 2016  /

REGDIMS
1 1 0 0 /

UNIFIN
UNIFOUT

------------------------------------------------------------------------
GRID
------------------------------------------------------------------------
INCLUDE
 'include/GRID.inc' /


------------------------------------------------------------------------
PROPS
------------------------------------------------------------------------
INCLUDE
 'include/PROPS.inc' /


------------------------------------------------------------------------
SOLUTION
------------------------------------------------------------------------

PRESSURE
30*150.
/

SGAS
30*0.0
/

SWAT
30*0.2
/

TEMPI
30*150
/

ZMF
30*0.05
30*0.15
30*0.80
/

------------------------------------------------------------------------
SUMMARY
------------------------------------------------------------------------
INCLUDE
 'include/SUMMARY.inc' /


------------------------------------------------------------------------
SCHEDULE
------------------------------------------------------------------------

INCLUDE
 'include/REPORTING.inc' /


WELSPECS
INJ  FIELD  1 1 1* WATER /
PROD FIELD 30 1 1* OIL /
/
COMPDAT
INJ   1 1 1 1 OPEN 2* 0.0151 /
PROD 30 1 1 1 OPEN 2* 0.0151 /
/

WCONINJE
INJ WATER OPEN RATE 0.4 1* 175 /
/

WCONPROD
PROD OPEN BHP 5* 120 /
/

TSTEP
0.1 0.4 0.5 1.0 3.0
38*2.5
/
WELLSTRE
ISTR 1.0 0.0 0.0 /
/
WINJGAS
INJ STREAM ISTR /
/
WCONINJE
INJ GAS OPEN RATE 0.4 1* 175 /
/
TSTEP
40*2.5
/
END
