------------------------------------------------------------------------
INIT

DX
30*10
/
DY
30*1
/
DZ
30*1
/
TOPS
30*0
/
-- Low enough for the pressures to even out over the first report steps.
PERMX
30*10
/
PERMY
30*10
/
PERMZ
30*10
/
PORO
30*0.1
/

