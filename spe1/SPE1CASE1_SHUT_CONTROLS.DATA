RSVD
   8300 1.270
   8450 1.270 /

---------------------------------------------------------------------------
SUMMARY
---------------------------------------------------------------------------

FOPR
FWIR
GOPR
   'GP' /
GWIR
   'GI' /
WMCTL
/
WSTAT
/
WBHP
/
WOPR
/
WWIR
/
-- Connection oil rates of the wells which may crossflow when stopped.
COFR
   'FS-ORAT' /
   'FS-GRUP' /
/

-- Tabulated summary vectors in a separate RSM file.
RUNSUM
SEPARATE

---------------------------------------------------------------------------
SCHEDULE
---------------------------------------------------------------------------

RPTSCHED
   'WELLS=2' /

RPTRST
   'BASIC=2' /

-- Producer VFP table, only for the THP limit of P-THP.
VFPPROD
-- Table  Datum  Rate   WFR    GFR    THP    ALQ   Units    Quantity
   1      8400   'LIQ'  'WCT'  'GOR'  'THP'  ' '   'FIELD'  'BHP' /
-- Liquid rates (stb/day)
   100 1000 5000 /
-- THP values (psia)
   200 500 1000 /
-- Water cuts
   0 0.5 /
-- Gas-oil ratios (Mscf/stb)
   0.5 1.5 /
-- Artificial lift quantities
   0 /
-- THP WFR GFR ALQ  BHP at each liquid rate
   1   1   1   1    2700 2800 3300 /
   1   1   2   1    2400 2500 3000 /
   1   2   1   1    3200 3300 3800 /
   1   2   2   1    2900 3000 3500 /
   2   1   1   1    3000 3100 3600 /
   2   1   2   1    2700 2800 3300 /
   2   2   1   1    3500 3600 4100 /
   2   2   2   1    3200 3300 3800 /
   3   1   1   1    3500 3600 4100 /
   3   1   2   1    3200 3300 3800 /
   3   2   1   1    4000 4100 4600 /
   3   2   2   1    3700 3800 4300 /

-- GP and GI hold the wells under group control, IND those under their own
-- control.  IND has no targets.
GRUPTREE
   'GP'   'FIELD' /
   'GI'   'FIELD' /
   'IND'  'FIELD' /
/

WELSPECS
-- Producers which never open
   'P-ORAT'    'IND'   2  2  8400  'OIL' /
   'P-WRAT'    'IND'   2  4  8400  'OIL' /
   'P-GRAT'    'IND'   2  6  8400  'OIL' /
   'P-LRAT'    'IND'   2  8  8400  'OIL' /
   'P-RESV'    'IND'   4  2  8400  'OIL' /
   'P-BHP'     'IND'   4  4  8400  'OIL' /
   'P-THP'     'IND'   4  6  8400  'OIL' /
   'P-GRUP'    'GP'    4  8  8400  'OIL' /
-- Water injectors which never open
   'I-RATE'    'IND'   6  2  8400  'WATER' /
   'I-BHP'     'IND'   6  4  8400  'WATER' /
   'I-GRUP'    'GI'    6  6  8400  'WATER' /
-- Wells which flow for a month and are then shut
   'F-ORAT'    'IND'   8  2  8400  'OIL' /
   'F-BHP'     'IND'   8  4  8400  'OIL' /
   'F-OLIM'    'IND'   8  6  8400  'OIL' /
   'F-GRUP'    'GP'    8  8  8400  'OIL' /
   'FI-RATE'   'IND'  10  2  8400  'WATER' /
   'FI-GRUP'   'GI'   10  4  8400  'WATER' /
-- Wells which are stopped from the start
   'S-ORAT'    'IND'   6  8  8400  'OIL' /
   'S-GRUP'    'GP'    6 10  8400  'OIL' /
-- Wells which flow for a month and are then stopped
   'FS-ORAT'   'IND'  10  6  8400  'OIL' /
   'FS-GRUP'   'GP'   10  8  8400  'OIL' /
/

COMPDAT
   'P-ORAT'     2  2  3  3  'OPEN'  1*  1*  0.5 /
   'P-WRAT'     2  4  3  3  'OPEN'  1*  1*  0.5 /
   'P-GRAT'     2  6  3  3  'OPEN'  1*  1*  0.5 /
   'P-LRAT'     2  8  3  3  'OPEN'  1*  1*  0.5 /
   'P-RESV'     4  2  3  3  'OPEN'  1*  1*  0.5 /
   'P-BHP'      4  4  3  3  'OPEN'  1*  1*  0.5 /
   'P-THP'      4  6  3  3  'OPEN'  1*  1*  0.5 /
   'P-GRUP'     4  8  3  3  'OPEN'  1*  1*  0.5 /
   'I-RATE'     6  2  3  3  'OPEN'  1*  1*  0.5 /
   'I-BHP'      6  4  3  3  'OPEN'  1*  1*  0.5 /
   'I-GRUP'     6  6  3  3  'OPEN'  1*  1*  0.5 /
   'F-ORAT'     8  2  3  3  'OPEN'  1*  1*  0.5 /
   'F-BHP'      8  4  3  3  'OPEN'  1*  1*  0.5 /
   'F-OLIM'     8  6  3  3  'OPEN'  1*  1*  0.5 /
   'F-GRUP'     8  8  3  3  'OPEN'  1*  1*  0.5 /
   'FI-RATE'   10  2  3  3  'OPEN'  1*  1*  0.5 /
   'FI-GRUP'   10  4  3  3  'OPEN'  1*  1*  0.5 /
   'S-ORAT'     6  8  3  3  'OPEN'  1*  1*  0.5 /
   'S-GRUP'     6 10  3  3  'OPEN'  1*  1*  0.5 /
   'FS-ORAT'   10  6  1  3  'OPEN'  1*  1*  0.5 /
   'FS-GRUP'   10  8  1  3  'OPEN'  1*  1*  0.5 /
/

GCONPROD
   'GP'  'ORAT'  800 /
/

GCONINJE
   'GI'  'WATER'  'RATE'  400 /
/

WCONPROD
-- Well          Status  Ctrl    ORAT   WRAT  GRAT  LRAT  RESV  BHP   THP  VFP
   'P-ORAT'      'SHUT'  'ORAT'  1000   4*                      1000 /
   'P-WRAT'      'SHUT'  'WRAT'  1*     500   3*                1000 /
   'P-GRAT'      'SHUT'  'GRAT'  2*           2000  2*          1000 /
   'P-LRAT'      'SHUT'  'LRAT'  3*                 1000  1*    1000 /
   'P-RESV'      'SHUT'  'RESV'  4*                       1500  1000 /
   'P-BHP'       'SHUT'  'BHP'   5*                             1000 /
   'P-THP'       'SHUT'  'THP'   5*                             1000  500  1 /
   'P-GRUP'      'SHUT'  'GRUP'  1000   4*                      1000 /
   'F-ORAT'      'OPEN'  'ORAT'  500    4*                      1000 /
   'F-BHP'       'OPEN'  'BHP'   5*                             4200 /
   'F-OLIM'      'OPEN'  'ORAT'  50000  4*                      4300 /
   'F-GRUP'      'OPEN'  'GRUP'  1000   4*                      1000 /
   'S-ORAT'      'STOP'  'ORAT'  1000   4*                      1000 /
   'S-GRUP'      'STOP'  'GRUP'  1000   4*                      1000 /
   'FS-ORAT'     'OPEN'  'ORAT'  500    4*                      1000 /
   'FS-GRUP'     'OPEN'  'GRUP'  1000   4*                      1000 /
/

WCONINJE
-- Well        Type     Status  Ctrl    Rate  RESV  BHP
   'I-RATE'    'WATER'  'SHUT'  'RATE'  1000  1*    6000 /
   'I-BHP'     'WATER'  'SHUT'  'BHP'   1000  1*    6000 /
   'I-GRUP'    'WATER'  'SHUT'  'GRUP'  1000  1*    6000 /
   'FI-RATE'   'WATER'  'OPEN'  'RATE'  500   1*    6000 /
   'FI-GRUP'   'WATER'  'OPEN'  'GRUP'  1000  1*    6000 /
/

-- Report steps 1 and 2: the F-*, FI-* and FS-* wells flow.
TSTEP
   1 30 /

WELOPEN
   'F-ORAT'      'SHUT' /
   'F-BHP'       'SHUT' /
   'F-OLIM'      'SHUT' /
   'F-GRUP'      'SHUT' /
   'FI-RATE'     'SHUT' /
   'FI-GRUP'     'SHUT' /
   'FS-ORAT'     'STOP' /
   'FS-GRUP'     'STOP' /
/

-- Report steps 3 and 4: the S-* and FS-* wells are stopped, all other
-- wells are shut.
TSTEP
   1 30 /

END
