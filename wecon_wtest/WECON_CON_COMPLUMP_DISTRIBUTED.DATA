-- Purpose: WECON 'CON' on a well whose lumped completion is split across MPI
-- ranks.  Run in serial and on two ranks with --allow-distributed-wells=true
-- and --partition-method=simple, which puts I = 1-3 on rank 0 and I = 4-6 on
-- rank 1.
--
-- Well P has four connections, all at the same depth, listed in this order
-- (COMPORD INPUT), with connection factors and initial water saturations
-- chosen to fix the water cuts:
--
--   cell     rank  completion  SWAT  water cut
--   (2,1,1)  0     2           0.5   0.63
--   (1,1,1)  0     1           0.2   0.00
--   (5,1,1)  1     1           0.7   0.95
--   (6,1,1)  1     3           0.2   0.00
--
-- Completion 1 lumps (1,1,1) and (5,1,1) and has a water cut of about 0.15.
-- The well's water cut of 0.22 violates the 0.2 limit on day 1, so
-- completion 2 is the worst offender.  Closing it leaves a water cut of 0.14,
-- so the workover stops there and P keeps producing from completions 1 and 3.
--
-- Two things can go wrong on two ranks:
--
-- * Ranking the completions by their rank-local rates makes completion 1 look
--   like the worst offender, because rank 1 holds only its wet part (0.95).
--   Completions 1 and 2 are then both closed.
--
-- * Once completion 2 is closed, rank 1 must still map its closed completions
--   onto its own perforations.  Counting the well's open connections instead
--   takes (2,1,1) for rank 1's first perforation and shuts (5,1,1).

RUNSPEC

TITLE
 WECON CON with a lumped completion split across ranks

DIMENS
 6 1 1 /

OIL
WATER
GAS
DISGAS

METRIC

START
 1 'JAN' 2026 /

WELLDIMS
 1 4 1 1 /

TABDIMS
 1 1 20 20 /

UNIFIN
UNIFOUT

GRID

INIT

DX
 6*1000 /
DY
 6*1000 /
DZ
 6*20 /
TOPS
 6*2000 /

PORO
 6*0.25 /
PERMX
 6*100 /
PERMY
 6*100 /
PERMZ
 6*10 /

PROPS

DENSITY
-- oil   water  gas
   850   1000   1.0 /

PVTW
-- pref  Bw   Cw     muw  Cv
   250   1.0  4e-5   0.5  0 /

-- The oil stays undersaturated throughout, so no free gas forms.
PVTO
-- Rs   Pbub  Bo    muo
   50   50    1.10  1.0
        300   1.08  1.0 /
   100  100   1.20  0.9
        300   1.18  0.9 /
/

PVDG
-- p    Bg     mug
   50   0.020  0.015
   150  0.007  0.018
   300  0.004  0.022 /

ROCK
 250 5e-5 /

SWOF
-- Sw   krw   krow  Pcow
   0.2  0.00  1.00  0
   0.3  0.05  0.60  0
   0.4  0.10  0.40  0
   0.5  0.20  0.25  0
   0.6  0.30  0.12  0
   0.7  0.40  0.05  0
   0.8  0.50  0.00  0
   1.0  1.00  0.00  0 /

SGOF
-- Sg   krg   krog  Pcog
   0.0  0.00  1.00  0
   0.1  0.00  0.70  0
   0.4  0.30  0.20  0
   0.7  0.80  0.00  0
   0.8  1.00  0.00  0 /

SOLUTION

PRESSURE
 6*250 /

SWAT
 0.2 0.5 0.2 0.2 0.7 0.2 /

SGAS
 6*0 /

RS
 6*50 /

SUMMARY

FOPR
FWPR
FWCT
WOPR
 'P' /
WWPR
 'P' /
WWCT
 'P' /
WBHP
 'P' /
COPR
 'P' 1 1 1 /
 'P' 2 1 1 /
 'P' 5 1 1 /
 'P' 6 1 1 /
/
CWPR
 'P' 1 1 1 /
 'P' 2 1 1 /
 'P' 5 1 1 /
 'P' 6 1 1 /
/

SCHEDULE

WELSPECS
 'P' 'G' 1 1 2010 'OIL' /
/

COMPDAT
-- well I J K1 K2 state satnum CF
 'P' 2 1 1 1 'OPEN' 1*  4.0 /
 'P' 1 1 1 1 'OPEN' 1* 10.0 /
 'P' 5 1 1 1 'OPEN' 1*  2.0 /
 'P' 6 1 1 1 'OPEN' 1*  1.0 /
/

COMPORD
 'P' 'INPUT' /
/

COMPLUMP
-- well I J K1 K2 completion
 'P' 2 1 1 1 2 /
 'P' 1 1 1 1 1 /
 'P' 5 1 1 1 1 /
 'P' 6 1 1 1 3 /
/

WCONPROD
 'P' 'OPEN' 'BHP' 5* 200 /
/

WECON
-- well minORAT minGRAT maxWCT maxGOR maxWGR workover endrun
 'P' 1* 1* 0.2 1* 1* 'CON' 'NO' /
/

TSTEP
 5*1 /

END
