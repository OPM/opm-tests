-- 1D water tracer IW1 with molecular diffusion (DIFFUSE and TRCDIFF, D = 36 cm2/hr), run with
-- flow_onephase. The tracer enters through the left boundary (BCCON, BCPROP and BCTRACER)
-- at a constant water rate.

-- Grid and properties
RUNSPEC
DIMENS
500 1 1
/

WATER
LAB

UNIFOUT

TRACERS
  0 2 0 0 8*
/

DIFFUSE

EQLDIMS
1 4*
/

REGDIMS
10 10 2*
/

TABDIMS
1 1* 1* 1*
/

-- Grid properties
GRID
DX
  500*0.2 /
DY
  500*1 /
DZ
  500*1 /
TOPS
  500*0.02 /
PORO
  500*0.2 /
PERMX
  500*100 /
PERMY
  500*100 /
PERMZ
  500*100 /

-- Boundary regions: index 1 = left face of first cell, index 2 = right face of last cell
BCCON
-- index I1  I2  J1 J2 K1 K2 dir
   1     1   1   1  1  1  1  X- /
   2     500 500 1  1  1  1  X+ /
/

INIT

EDIT

PROPS

-- Activate tracer
TRACER
  'IW1' 'WAT' /
/

-- Molecular diffusion coefficient of the tracer (cm2/hr in LAB units)
TRCDIFF
-- tracer D_mol
   IW1    36.0 /
/

PVTW
276.8 1.0 4.54E-11 0.31 0
/

-- Specify constant rock compressibility.
ROCK
1.0 4.35D-11 /

DENSITY
0.7 1.02 0.0018475
/

REGIONS
FIPNUM
500*1
/

SOLUTION

-- Initial conditions
EQUIL
  0.5 50.0 0.0 0.0 /
SWAT
  500*1.0 /   -- Initial water saturations
TBLKFIW1
  500*0.0 /   -- Initial free tracer concentrations
TBLKSIW1
  500*0.0 /   -- Initial solute tracer concentrations

SUMMARY
ALL
--TCNFIW1
--TIPTIW1
/

SCHEDULE

RPTRST
BASIC=3 FREQ=100 /

-- Constant water rate from left to right through the boundary faces.
-- Positive rate is out of the domain, negative is into the domain.
-- 36.72 g/(hr cm2) over 1 cm2 with surface density 1.02 g/cm3 is 36 cm3/hr,
-- i.e. interstitial velocity 180 cm/hr (porosity 0.2). The front reaches x = 40 cm of 100 cm
-- after 0.2222 hr. Cell size 0.2 cm and CFL = 0.5.
BCPROP
-- index type component rate
   1     RATE WATER     -36.72 /
   2     RATE WATER      36.72 /
/

-- Tracer IW1 (water phase) enters through the left boundary with concentration 1
BCTRACER
-- index tracer concentration
   1     IW1    1.0 /
/

TSTEP
  400*5.5556E-4 /
/

END