-- 1D water tracer test with boundary conditions (BCCON, BCPROP and BCTRACER).
-- A constant water rate flows from the left to the right boundary. The tracer
-- IW1 enters through the left boundary with concentration 1. After 8 hr the
-- front (c = 0.5) is at x = 40 cm.

-- Grid and properties
RUNSPEC
DIMENS
100 1 1
/

WATER
LAB

TRACERS
  0 2 0 0 8*
/

EQLDIMS
1 4*
/

REGDIMS
10 10 2*
/

TABDIMS
1 1* 1* 1*
/

-- Grid properties
GRID
DX
  100*1 /
DY
  100*1 /
DZ
  100*1 /
TOPS
  100*0.1 /
PORO
  100*0.2 /
PERMX
  100*100 /
PERMY
  100*100 /
PERMZ
  100*100 /

-- Boundary regions: index 1 = left face of first cell, index 2 = right face of last cell
BCCON
-- index I1  I2  J1 J2 K1 K2 dir
   1     1   1   1  1  1  1  X- /
   2     100 100 1  1  1  1  X+ /
/

INIT

EDIT

PROPS

-- Activate tracer
TRACER
  'IW1' 'WAT' /
/

PVTW
276.8 1.0 4.54E-11 0.31 0
/

-- Specify constant rock compressibility.
ROCK
1.0 4.35D-11 /

DENSITY
0.7 1.02 0.0018475
/

REGIONS
FIPNUM
100*1
/

SOLUTION

-- Initial conditions
EQUIL
  0.5 50.0 0.0 0.0 /
SWAT
  100*1.0 /   -- Initial water saturations
TBLKFIW1
  100*0.0 /   -- Initial free tracer concentrations
TBLKSIW1
  100*0.0 /   -- Initial solute tracer concentrations

SUMMARY
ALL
--TCNFIW1
--TIPTIW1
/

SCHEDULE

RPTRST
BASIC=2 /

-- Constant water rate from left to right through the boundary faces.
-- Positive rate is out of the domain, negative is into the domain.
-- 1.02 g/(hr cm2) over 1 cm2 with surface density 1.02 g/cm3 is 1 cm3/hr,
-- i.e. interstitial velocity 5 cm/hr (porosity 0.2).
BCPROP
-- index type component rate
   1     RATE WATER     -1.02 /
   2     RATE WATER      1.02 /
/

-- Tracer IW1 (water phase) enters through the left boundary with concentration 1
BCTRACER
-- index tracer concentration
   1     IW1    1.0 /
/

TSTEP
  80*0.1 /
/

END
