SCHEDULE
------------------------------------------------------------------------------------------------

-- Start of Simulation: 10 'OCT' 2018

GRUPTREE
 'PLAT-A'  'FIELD' /
 'D1'      'PLAT-A' /
 'E1'      'PLAT-A' /
/

TUNING
 1.0 1.0  /
 /
 /

WELSPECS
  'D-1H'   'D1'   2   2  1*       'OIL'  2*      'SHUT'  4* /
  'D-2H'   'D1'   4   1  1*       'OIL'  2*      'SHUT'  4* /
  'E-1H'   'E1'   6   5  1*       'WAT'  2*      'SHUT'  4* /
  'E-2H'   'E1'   1   5  1*       'WAT'  2*      'SHUT'  4* /
/

COMPDAT
-- WELL     I   J  K1  K2   STATE   Sat.  CF  DIAM   KH  SKIN  ND  DIR   Ro
  'D-1H'   2   2   1   4   'OPEN'  1*    1*  0.216  1*  20.0  1*  'Z'  1* /
  'D-2H'   4   2   1   4   'OPEN'  1*    1*  0.216  1*  20.0  1*  'Z'  1* /
  'E-1H'   6   5   4   7   'OPEN'  1*    1*  0.216  1*  1*    1*  'Z'  1* /
  'E-2H'   1   5   4   7   'OPEN'  1*    1*  0.216  1*  1*    1*  'Z'  1* /
/


WELSEGS
-- Name     TVD-top    MD-top    Wvol  Info
 'D-2H'    2525.841   2525.841   1*    'INC' /
-- first last branch outlet  length  depth-chg  ID     rough
    2     2    1      1      4.997   4.997      0.15   1.0E-5 /
    3     3    1      2      4.996   4.996      0.15   1.0E-5 /
    4     4    1      3      4.996   4.996      0.15   1.0E-5 /
/

COMPSEGS
 'D-2H' /
-- I  J  K  branch  MD-start   MD-end
   4  2  1  1       2523.343   2528.339 /
   4  2  2  1       2528.340   2533.336 /
   4  2  3  1       2533.336   2538.332 /
   4  2  4  1       2538.332   2543.328 /
/


WCONPROD
--  Well_name  Status  Ctrl  Orate   Wrate  Grate Lrate   RFV  FBHP   WHP  VFP Glift
  'D-1H'      OPEN     ORAT   500.0  1*     1*    3000.0  1*   75.0  1*   1*   1*  /
  'D-2H'      OPEN     ORAT  1000.0  1*     1*    3000.0  1*   75.0  1*   1*   1*  /
/

-- BHP limited so that the injectors supply whatever voidage replacement the
-- producers need, holding both fault compartments near 300 bar.
WCONINJE
 'E-1H' 'WATER' 'OPEN'  'RATE'  5000.0  1*  300.0 /
 'E-2H' 'WATER' 'OPEN'  'RATE'  5000.0  1*  300.0 /
/

-- Report the drawdown directly as a summary vector, so that it can be
-- compared against the WELDRAW limit step for step.
UDQ
 DEFINE WUDD WBP - WBHP /
 UNITS  WUDD BARSA /
/


DATES
 1 NOV 2018 /
 1 DEC 2018 /
/

DATES
 1 JAN 2019 /
 1 FEB 2019 /
 1 MAR 2019 /
/

DATES
 1 APR 2019 /
 1 MAY 2019 /
 1 JUN 2019 /
/




END
