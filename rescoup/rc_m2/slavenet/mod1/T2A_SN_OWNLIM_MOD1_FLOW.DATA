-- rc_m2/slavenet, OWNLIM: as T2A_SN_MOD1_FLOW.DATA, started with the master deck
-- TEST2A_SN_OWNLIM_FLOW.DATA.  From 20 Oct 2018 the slave group MANI-D has a GCONPROD record of its
-- own with only a gas rate limit (300000 Sm3/d, action RATE), below its gas rate, and the GRUPSLAV
-- flag BOTH for gas, so that this limit applies together with the master's.  The group breaks the
-- limit and is controlled on gas, while the master's target is an oil rate.  The GRUPSLAV oil flag is
-- BOTH for MANI-D and MANI-B, which have no oil limit of their own: the master's oil target is then
-- the one that applies.  TUNING limits the time steps to 1 day.
--
-- This deck is used for testing reservoir coupling.  It is the slave RES-1 of rc_m2/slavenet, started
-- with the master deck TEST2A_SN_FLOW.DATA.  As the slave RES-1 of rc_m2/t2a, but with a network of its
-- own (NETWORK, BRANPROP and NODEPROP in the SCHEDULE section): MANI-B and MANI-D are fixed-pressure
-- nodes, with the wells in these groups, and the pressure of the master is their fixed pressure.  The
-- two branches carry no flow (MANI-C and MANI-F have no producers); a network needs a branch.

RUNSPEC

INCLUDE
 '../../t2a/mod1/include/runspec.inc' /

-- slavenet: this slave has a network of its own, see BRANPROP/NODEPROP in SCHEDULE.
NETWORK
 4 2 /

VFPPDIMS
 19  10  10  10  0  3 /

--------------------------------------------------------------------------------

GRID

INCLUDE
 '../../t2a/mod1/include/grid.inc' /

--------------------------------------------------------------------------------

EDIT

--------------------------------------------------------------------------------

PROPS

INCLUDE
 '../../t2a/mod1/include/props.inc' /

--------------------------------------------------------------------------------

REGIONS

INCLUDE
 '../../t2a/mod1/include/regions.inc' /

--------------------------------------------------------------------------------

SOLUTION

INCLUDE
 '../../t2a/mod1/include/solution.inc' /

--------------------------------------------------------------------------------

SUMMARY

NEWTON
MLINEARS

--
INCLUDE
 '../../t2a/mod1/include/summary.data' /

--
INCLUDE
 '../../../common/mod1/gas.inc' /


FUCOL

FUGIRC4H
FUGIRC5H

ROIP_COL
/

GGIRT
/

WMCTL
/

WUBHPWI
/

WUIWBP4
/

WPI4
/

WPI
/
WBP4
/

--------------------------------------------------------------------------------


SCHEDULE

TUNING
 0.5 1.0 /
 /
 /


INCLUDE
 '../../../common/mod1/B2H.Ecl' /

INCLUDE
 '../../../common/mod1/D1CH.Ecl' /

INCLUDE
 '../../../common/mod1/D2H.Ecl' /


GRUPTREE
 'PLAT-A'  'FIELD' /
 'MANI-B'  'PLAT-A'  /
 'MANI-D'  'PLAT-A'  /
 'MANI-C'  'PLAT-A'  /
 'MANI-F'  'PLAT-A'  /
/

GRUPSLAV
 'MANI-D'  'D1_M'  'BOTH'  1*  'BOTH' /
 'MANI-B'  'B1_M'  'BOTH' /
 'MANI-C'  'C1_M' /
 'MANI-F'  'F1_M' /
/

-- slavenet: MANI-B and MANI-D are fixed-pressure nodes, so the node pressures the
-- master sends for B1_M and D1_M are applied as dynamic THP limits on their wells.
-- The two branches carry no flow (MANI-C and MANI-F have no producers); they are only
-- there because a network needs a branch.  The pressure of 25 bar is replaced by the
-- master's pressure at every exchange.
BRANPROP
 MANI-F  MANI-B  1  1* /
 MANI-C  MANI-D  1  1* /
/

NODEPROP
 MANI-B  25.0  NO  NO  1* /
 MANI-D  25.0  NO  NO  1* /
 MANI-F  1*    NO  NO  1* /
 MANI-C  1*    NO  NO  1* /
/


WELSPECS
 'C-4H' 'MANI-C' 11 17 1* 'GAS' /
 'C-1H' 'MANI-C' 26 26 1* 'WATER' /
 'B-2H' 'MANI-B' 15 13 2627.84 'OIL' 2* 'STOP' /
 'D-1H' 'MANI-D' 22  4 2595.82 'OIL' 2* 'STOP' /
 'D-2H' 'MANI-D' 14 10 2643.21 'OIL' 2* 'STOP' /
/

INCLUDE
 '../../t2a/mod1/include/completions.inc' /

-- The schedule from 1 to 20 Oct 2018, the same in all RES-1 decks of rc_m2. It ends with
-- the injection controls of C-4H, C-1H and F-1H, which hold for the rest of the run.
INCLUDE
 '../../t2a/mod1/include/schedule_oct2018.inc' /


WCONPROD
  'B-2H'  'OPEN'  'ORAT'  4000.0 1*  4.0E6 2*    1*  25.0  1   /
  'D-1H'  'OPEN'  'ORAT'  4000.0 1*  4.0E6 2*    1*  25.0  2   /
  'D-2H'  'OPEN'  'ORAT'  4000.0 1*  4.0E6 2*    1*  25.0  3   /
/

-- A gas rate limit of MANI-D itself, below its gas rate.
GCONPROD
 'MANI-D'  'NONE'  1*  1*  300000.0  1*  'RATE'  'YES'  1*  1*  'RATE'  'RATE'  'RATE' /
/


DATES
 1 NOV 2018 /
/


DATES
 1 DEC 2018 /
/

--WELOPEN
-- 'C-5H' 'OPEN' /
--/

NEXTSTEP
 1.0 /

WELOPEN
 'F-1H' 'OPEN' /
/


DATES
 1 JAN 2019 /
 1 FEB 2019 /
 1 MAR 2019 /
 1 APR 2019 /
 1 MAY 2019 /
 1 JUN 2019 /
 1 JUl 2019 /
/

END
