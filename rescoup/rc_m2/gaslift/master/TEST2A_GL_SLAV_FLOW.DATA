-- This deck tests usage of reservoir coupling.

-- This case is a pure prediction case (no history). The master model includes one grid cell
-- and no wells. The master deck is used only for controlling production and injection
-- from the two slave models.

-- rc_m2/gaslift, SLAV: as TEST2A_GL_FLOW.DATA, but the slave RES-1 (T2A_GL_SLAV_MOD1_FLOW.DATA)
-- has the GRUPSLAV oil flag SLAV for MANI-B and MANI-D, and an oil rate target of its own for both
-- groups.  The gas flag keeps its default MAST.  The master changes the rate type of its targets
-- for these groups from oil to gas on 1 Dec 2018 (GCONPROD with GRAT for D1_M and B1_M, below
-- their gas rates, so that the targets bind), and back to oil on 1 Feb 2019.  The gas target puts
-- the slave groups on gas rate control (flag MAST), and when the master returns to an oil target
-- (flag SLAV), the slave groups must leave gas rate control again, since they have no gas limit of
-- their own.  GMCTP in the master and in the slave shows the control modes.  The slave RES-2 is
-- the one of rc_m2/t2a.

------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
RUNSPEC
------------------------------------------------------------------------------------------------

INCLUDE
 '../../t2a/master/include/runspec.inc' /

------------------------------------------------------------------------------------------------
GRID
------------------------------------------------------------------------------------------------

INCLUDE
 '../../t2a/master/include/grid.inc' /

------------------------------------------------------------------------------------------------
EDIT
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
PROPS
------------------------------------------------------------------------------------------------

INCLUDE
 '../../t2a/master/include/props.inc' /

------------------------------------------------------------------------------------------------
REGIONS
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
SOLUTION
------------------------------------------------------------------------------------------------

INCLUDE
 '../../t2a/master/include/solution.inc' /

------------------------------------------------------------------------------------------------
SUMMARY
-----------------------------------------------------------------------------------------------

INCLUDE
 'include/summary.inc' /

INCLUDE
 '../../t2a/master/include/summary_groups.inc' /

GMCTP
/

------------------------------------------------------------------------------------------------
SCHEDULE
------------------------------------------------------------------------------------------------


-- Time step controls, VFP tables of the master network, and GRUPTREE
INCLUDE
 '../../t2a/master/include/schedule_start.inc' /

SLAVES
  'RES-1'  'T2A_GL_SLAV_MOD1_FLOW'   '*'  '../mod1'  4 /
  'RES-2'  'T2A_MOD2_FLOW'   '*'  '../../t2a/mod2'  1 /
/

INCLUDE
 '../../t2a/master/include/grupmast.inc' /

BRANPROP
--  Downtree  Uptree	  #VFP  ALQ
    B1_M	'PLAT-A'    3   1* /
    D1_M	'PLAT-A'    4   1* /
    E1_M	'PLAT-A'    5	1* /
/

NODEPROP
--  Node_name  Press  autoChoke?  addGasLift?  Group_name
     PLAT-A	21.0   NO        NO	    1*  /
     B1_M	1*     NO	 NO	    1*  /
     D1_M	1*     NO	 NO	    1*  /
     E1_M	1*     NO	 NO	    1*  /
/

UDQ
 ASSIGN FUQOMAX 9000.0 /
/

DATES
 2 'OCT' 2018 /
/

DATES
 5 'OCT' 2018 /
/

DATES
 10 'OCT' 2018 /
/

DATES
 15 'OCT' 2018 /
/


GUIDERAT
 30.0 OIL 1.0 1.0 1* 1*  1.0  0.2  1*  0.1  /


GCONPROD
 'FIELD' 'ORAT'   FUQOMAX  1*  6.9E6   1*   'RATE'  /

 'D1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'B1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'C1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'F1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'E1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
/

GCONSUMP
  'FIELD'  200000 /
/

GCONINJE
-- 'FIELD' 'GAS'   'REIN'   4.0E6  1*  1.0  /
-- 'D1_M'  'GAS'   'RATE'   4.0E6  4*  1.0  'RATE' /
-- 'B1_M'  'GAS'   'RATE'   4.0E6  4*  1.0  'RATE' /
-- 'C1_M'  'GAS'   'RATE'   4.0E6  4*  1.0  'RATE' /
-- 'E1_M'  'GAS'   'RATE'   4.0E6  4*  1.0  'RATE' /
 'D1_M'  'WATER' 'RATE'   4.0E6  4*  1.0  'RATE' /
 'B1_M'  'WATER' 'RATE'   4.0E6  4*  1.0  'RATE' /

 'MOD1'  'WATER' 'RATE' 15000.0 /

 'C1_M'  'WATER' 'NONE' 5* 0 'NETV' /
 'F1_M'  'WATER' 'NONE' 5* 0 'NETV' /

 'E1_M'  'WATER' 'RATE'   4.0E6  4*  1.0  'RATE' /

/

DATES
 19 'OCT' 2018 /
/

DATES
 20 'OCT' 2018 /
/


DATES
 1 NOV 2018 /
/


DATES
 1 DEC 2018 /
/

-- Gas targets for D1_M and B1_M, below their gas rates, so that they bind.  Item 8 'NO' keeps the
-- groups on their own targets instead of the guide-rate share of the oil target of FIELD.
GCONPROD
 'D1_M'  'GRAT'   9200.0  1*  450000.0   1*   'RATE'  'NO'  1*  'FORM'  /
 'B1_M'  'GRAT'   9200.0  1*  300000.0   1*   'RATE'  'NO'  1*  'FORM'  /
/

DATES
 1 JAN 2019 /
/


DATES
 1 FEB 2019 /
/

-- Back to the oil targets.
GCONPROD
 'D1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'B1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
/

DATES
 1 MAR 2019 /
 1 APR 2019 /
 1 MAY 2019 /
 1 JUN 2019 /
 1 JUL 2019 /
/

END
