-- This deck tests usage of reservoir coupling.

-- This case is a pure prediction case (no history). The master model includes one grid cell
-- and no wells. The master deck is used only for controlling production and injection
-- from the two slave models.

-- rc_m2/gaslift: as TEST2A_GL_FLOW.DATA, with a lift gas limit of 1.2E5 Sm3/d on MOD1, the parent of
-- the master groups of the slave RES-1 (GLIFTOPT below, with the LIFTOPT it needs).  The master
-- shares it between the slave groups in proportion to how much more lift gas their wells can take,
-- and sends the limits to the slave, whose own GLIFTOPT records (2.5E5 on MANI-D, 2.0E5 on MANI-B)
-- are looser.

------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
RUNSPEC
------------------------------------------------------------------------------------------------

INCLUDE
 '../../t2a/master/include/runspec.inc' /

------------------------------------------------------------------------------------------------
GRID
------------------------------------------------------------------------------------------------

INCLUDE
 '../../t2a/master/include/grid.inc' /

------------------------------------------------------------------------------------------------
EDIT
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
PROPS
------------------------------------------------------------------------------------------------

INCLUDE
 '../../t2a/master/include/props.inc' /

------------------------------------------------------------------------------------------------
REGIONS
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
SOLUTION
------------------------------------------------------------------------------------------------

INCLUDE
 '../../t2a/master/include/solution.inc' /

------------------------------------------------------------------------------------------------
SUMMARY
-----------------------------------------------------------------------------------------------

INCLUDE
 'include/summary.inc' /

INCLUDE
 '../../t2a/master/include/summary_groups.inc' /

------------------------------------------------------------------------------------------------
SCHEDULE
------------------------------------------------------------------------------------------------


-- Time step controls, VFP tables of the master network, and GRUPTREE
INCLUDE
 '../../t2a/master/include/schedule_start.inc' /

SLAVES
  'RES-1'  'T2A_GL_MOD1_FLOW'   '*'  '../mod1'  4 /
  'RES-2'  'T2A_MOD2_FLOW'   '*'  '../../t2a/mod2'  1 /
/

INCLUDE
 '../../t2a/master/include/grupmast.inc' /

BRANPROP
--  Downtree  Uptree	  #VFP  ALQ
    B1_M	'PLAT-A'    3   1* /
    D1_M	'PLAT-A'    4   1* /
    E1_M	'PLAT-A'    5	1* /
/

NODEPROP
--  Node_name  Press  autoChoke?  addGasLift?  Group_name
     PLAT-A	21.0   NO        NO	    1*  /
     B1_M	1*     NO	 NO	    1*  /
     D1_M	1*     NO	 NO	    1*  /
     E1_M	1*     NO	 NO	    1*  /
/

UDQ
 ASSIGN FUQOMAX 9000.0 /
/

DATES
 2 'OCT' 2018 /
/

DATES
 5 'OCT' 2018 /
/

DATES
 10 'OCT' 2018 /
/

DATES
 15 'OCT' 2018 /
/


GUIDERAT
 30.0 OIL 1.0 1.0 1* 1*  1.0  0.2  1*  0.1  /


GCONPROD
 'FIELD' 'ORAT'   FUQOMAX  1*  6.9E6   1*   'RATE'  /

 'D1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'B1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'C1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'F1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'E1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
/

-- Lift gas limit on MOD1, the parent of the RES-1 master groups.  The master passes it on to the
-- slave groups; the slave GLIFTOPT records (2.5E5 on MANI-D, 2.0E5 on MANI-B) are looser.
LIFTOPT
-- incr.size  min.econ.grad  min.interval  optimize.in.newton
   12500.0    5.0E-3         0.0           YES /

GLIFTOPT
-- group    max.lift.gas  max.total.gas
  'MOD1'  1.2E5         1* /
/

GCONSUMP
  'FIELD'  200000 /
/

GCONINJE
-- 'FIELD' 'GAS'   'REIN'   4.0E6  1*  1.0  /
-- 'D1_M'  'GAS'   'RATE'   4.0E6  4*  1.0  'RATE' /
-- 'B1_M'  'GAS'   'RATE'   4.0E6  4*  1.0  'RATE' /
-- 'C1_M'  'GAS'   'RATE'   4.0E6  4*  1.0  'RATE' /
-- 'E1_M'  'GAS'   'RATE'   4.0E6  4*  1.0  'RATE' /
 'D1_M'  'WATER' 'RATE'   4.0E6  4*  1.0  'RATE' /
 'B1_M'  'WATER' 'RATE'   4.0E6  4*  1.0  'RATE' /

 'MOD1'  'WATER' 'RATE' 15000.0 /

 'C1_M'  'WATER' 'NONE' 5* 0 'NETV' /
 'F1_M'  'WATER' 'NONE' 5* 0 'NETV' /

 'E1_M'  'WATER' 'RATE'   4.0E6  4*  1.0  'RATE' /

/

DATES
 19 'OCT' 2018 /
/

DATES
 20 'OCT' 2018 /
/


DATES
 1 NOV 2018 /
/


DATES
 1 DEC 2018 /
 1 JAN 2019 /
/


DATES
 1 FEB 2019 /
/

DATES
 1 MAR 2019 /
 1 APR 2019 /
 1 MAY 2019 /
 1 JUN 2019 /
 1 JUL 2019 /
/

END
