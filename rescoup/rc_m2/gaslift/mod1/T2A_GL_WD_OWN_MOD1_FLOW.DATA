-- rc_m2/gaslift, WD_OWN: as T2A_GL_MOD1_FLOW.DATA, but the slave group MANI-D has the GRUPSLAV
-- gas flag BOTH and a gas limit of its own (GCONPROD after GRUPSLAV), high enough never to bind,
-- and no oil limit.  Started with the master deck TEST2A_GL_WD_OWN_FLOW.DATA, in which the master
-- withdraws the production target of MANI-D.
--
-- This deck is used for testing reservoir coupling.  It is the slave RES-1 of rc_m2/gaslift, started
-- with the master decks TEST2A_GL_*_FLOW.DATA.  As the slave RES-1 of rc_m2/t2a, with gas lift: the
-- VFP tables of B-2H, D-1H and D-2H (include/B2H_GL.Ecl, D1CH_GL.Ecl and D2H_GL.Ecl, made from the
-- tables in rescoup/common/mod1 with an ALQ axis added, see the headers of the files) have an ALQ axis for the lift gas rate (0 to
-- 400000 Sm3/d, VFPPDIMS item 5 is 6).  The THP limit of the wells is 100 bar instead of 25, so that
-- they cannot meet the target of the master without lift gas, and LIFTOPT, WLIFTOPT and GLIFTOPT are
-- added.

RUNSPEC

INCLUDE
 '../../t2a/mod1/include/runspec.inc' /

VFPPDIMS
-- max.ALQ raised from 0 to 6 for the lift-gas axis of the *_GL.Ecl tables
 19  10  10  10  6  3 /

--------------------------------------------------------------------------------

GRID

INCLUDE
 '../../t2a/mod1/include/grid.inc' /

--------------------------------------------------------------------------------

EDIT

--------------------------------------------------------------------------------

PROPS

INCLUDE
 '../../t2a/mod1/include/props.inc' /

--------------------------------------------------------------------------------

REGIONS

INCLUDE
 '../../t2a/mod1/include/regions.inc' /

--------------------------------------------------------------------------------

SOLUTION

INCLUDE
 '../../t2a/mod1/include/solution.inc' /

--------------------------------------------------------------------------------

SUMMARY

NEWTON
MLINEARS

--
INCLUDE
 '../../t2a/mod1/include/summary.data' /

--
INCLUDE
 '../../../common/mod1/gas.inc' /


FUCOL

FUGIRC4H
FUGIRC5H

ROIP_COL
/

GGIRT
/

WMCTL
/

-- Gas lift
WGLIR
 'B-2H' 'D-1H' 'D-2H' /
WOPR
/
WGPR
/
WTHP
/
WBHP
/
GGLIR
 'MANI-B' 'MANI-D' 'PLAT-A' /
GOPR
 'MANI-B' 'MANI-D' 'PLAT-A' /
FGLIR

WUBHPWI
/

WUIWBP4
/

WPI4
/

WPI
/
WBP4
/

--------------------------------------------------------------------------------


SCHEDULE


INCLUDE
 'include/B2H_GL.Ecl' /

INCLUDE
 'include/D1CH_GL.Ecl' /

INCLUDE
 'include/D2H_GL.Ecl' /


GRUPTREE
 'PLAT-A'  'FIELD' /
 'MANI-B'  'PLAT-A'  /
 'MANI-D'  'PLAT-A'  /
 'MANI-C'  'PLAT-A'  /
 'MANI-F'  'PLAT-A'  /
/

GRUPSLAV
 'MANI-D'  'D1_M' 2* 'BOTH' /
 'MANI-B'  'B1_M' /
 'MANI-C'  'C1_M' /
 'MANI-F'  'F1_M' /
/

-- A gas limit of MANI-D itself, used with the gas flag BOTH above.  It never binds.
GCONPROD
 'MANI-D'  'GRAT'  2*  2.0E6  1*  'RATE' /
/


WELSPECS
 'C-4H' 'MANI-C' 11 17 1* 'GAS' /
 'C-1H' 'MANI-C' 26 26 1* 'WATER' /
 'B-2H' 'MANI-B' 15 13 2627.84 'OIL' 2* 'STOP' /
 'D-1H' 'MANI-D' 22  4 2595.82 'OIL' 2* 'STOP' /
 'D-2H' 'MANI-D' 14 10 2643.21 'OIL' 2* 'STOP' /
/

INCLUDE
 '../../t2a/mod1/include/completions.inc' /

-- The schedule from 1 to 20 Oct 2018, the same in all RES-1 decks of rc_m2. It ends with
-- the injection controls of C-4H, C-1H and F-1H, which hold for the rest of the run.
INCLUDE
 '../../t2a/mod1/include/schedule_oct2018.inc' /


-- THP limit raised from 25 (t2a) to 100 bar so that the wells cannot meet
-- the master's ORAT target without lift gas.
WCONPROD
  'B-2H'  'OPEN'  'ORAT'  4000.0 1*  4.0E6 2*    1*  100.0  1   /
  'D-1H'  'OPEN'  'ORAT'  4000.0 1*  4.0E6 2*    1*  100.0  2   /
  'D-2H'  'OPEN'  'ORAT'  4000.0 1*  4.0E6 2*    1*  100.0  3   /
/

-- ---------------------------------------------------------------------------
-- Gas lift optimization (not present in t2a)
-- ---------------------------------------------------------------------------
LIFTOPT
-- incr.size  min.econ.grad  min.interval  optimize.in.newton
   12500.0    5.0E-3         0.0           YES /

WLIFTOPT
-- well    optimize  max.rate  weight  min.rate
  'B-2H'   YES       2.0E5     1*      0.0 /
  'D-1H'   YES       2.0E5     1*      0.0 /
  'D-2H'   YES       2.0E5     1*      0.0 /
/

-- Limits on the lift gas of the slave groups.  A slave group with gas-lift wells does not need a
-- GLIFTOPT record (see T2A_GL_NOGRP_MOD1_FLOW.DATA); they are here to test the limits of the
-- slave groups themselves.  Where the master gives a limit as well (TEST2A_GL_MGL_*_FLOW.DATA),
-- the slave applies the smaller of the two.
GLIFTOPT
-- group    max.lift.gas  max.total.gas
  'MANI-D'  2.5E5         1* /
  'MANI-B'  2.0E5         1* /
/


DATES
 1 NOV 2018 /
/


DATES
 1 DEC 2018 /
/

--WELOPEN
-- 'C-5H' 'OPEN' /
--/

NEXTSTEP
 1.0 /

WELOPEN
 'F-1H' 'OPEN' /
/


DATES
 1 JAN 2019 /
 1 FEB 2019 /
 1 MAR 2019 /
 1 APR 2019 /
 1 MAY 2019 /
 1 JUN 2019 /
 1 JUl 2019 /
/

END
