-- This deck tests usage of reservoir coupling.

-- This case is a pure prediction case (no history). The master model includes one grid cell
-- and no wells. The master deck is used only for controlling production and injection
-- from the two slave models.

-- rc_m2/t2a: the base case.  The FIELD oil rate target (the UDQ FUQOMAX, 9000 Sm3/d) is distributed
-- over the master groups B1_M, D1_M, C1_M, F1_M (groups MANI-B, MANI-D, MANI-C, MANI-F of the slave
-- RES-1) and E1_M (group E1 of the slave RES-2) with the guide rates, and each master group has an
-- oil rate limit of 9200 Sm3/d.  The master has a network with PLAT-A as its fixed-pressure node, at
-- 21 bar, so that the THP limits do not bind.  The slave RES-1 has no network of its own.

------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
RUNSPEC
------------------------------------------------------------------------------------------------

INCLUDE
 'include/runspec.inc' /

------------------------------------------------------------------------------------------------
GRID
------------------------------------------------------------------------------------------------

INCLUDE
 'include/grid.inc' /

------------------------------------------------------------------------------------------------
EDIT
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
PROPS
------------------------------------------------------------------------------------------------

INCLUDE
 'include/props.inc' /

------------------------------------------------------------------------------------------------
REGIONS
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
SOLUTION
------------------------------------------------------------------------------------------------

INCLUDE
 'include/solution.inc' /

------------------------------------------------------------------------------------------------
SUMMARY
-----------------------------------------------------------------------------------------------

INCLUDE
 'include/summary.inc' /

INCLUDE
 'include/summary_groups.inc' /

------------------------------------------------------------------------------------------------
SCHEDULE
------------------------------------------------------------------------------------------------


-- Time step controls, VFP tables of the master network, and GRUPTREE
INCLUDE
 'include/schedule_start.inc' /

SLAVES
  'RES-1'  'T2A_MOD1_FLOW'   '*'  '../mod1'  4 /
  'RES-2'  'T2A_MOD2_FLOW'   '*'  '../mod2'  1 /
/

INCLUDE
 'include/grupmast.inc' /

BRANPROP
--  Downtree  Uptree	  #VFP  ALQ
    B1_M	'PLAT-A'    3   1* /
    D1_M	'PLAT-A'    4   1* /
    E1_M	'PLAT-A'    5	1* /
/

NODEPROP
--  Node_name  Press  autoChoke?  addGasLift?  Group_name
     PLAT-A	21.0   NO        NO	    1*  /
     B1_M	1*     NO	 NO	    1*  /
     D1_M	1*     NO	 NO	    1*  /
     E1_M	1*     NO	 NO	    1*  /
/

UDQ
 ASSIGN FUQOMAX 9000.0 /
/

DATES
 2 'OCT' 2018 /
/

DATES
 5 'OCT' 2018 /
/

DATES
 10 'OCT' 2018 /
/

DATES
 15 'OCT' 2018 /
/


GUIDERAT
 30.0 OIL 1.0 1.0 1* 1*  1.0  0.2  1*  0.1  /


GCONPROD
 'FIELD' 'ORAT'   FUQOMAX  1*  6.9E6   1*   'RATE'  /

 'D1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'B1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'C1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'F1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'E1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
/

GCONSUMP
  'FIELD'  200000 /
/

GCONINJE
-- 'FIELD' 'GAS'   'REIN'   4.0E6  1*  1.0  /
-- 'D1_M'  'GAS'   'RATE'   4.0E6  4*  1.0  'RATE' /
-- 'B1_M'  'GAS'   'RATE'   4.0E6  4*  1.0  'RATE' /
-- 'C1_M'  'GAS'   'RATE'   4.0E6  4*  1.0  'RATE' /
-- 'E1_M'  'GAS'   'RATE'   4.0E6  4*  1.0  'RATE' /
 'D1_M'  'WATER' 'RATE'   4.0E6  4*  1.0  'RATE' /
 'B1_M'  'WATER' 'RATE'   4.0E6  4*  1.0  'RATE' /

 'MOD1'  'WATER' 'RATE' 15000.0 /

 'C1_M'  'WATER' 'NONE' 5* 0 'NETV' /
 'F1_M'  'WATER' 'NONE' 5* 0 'NETV' /

 'E1_M'  'WATER' 'RATE'   4.0E6  4*  1.0  'RATE' /

/

DATES
 19 'OCT' 2018 /
/

DATES
 20 'OCT' 2018 /
/


DATES
 1 NOV 2018 /
/


DATES
 1 DEC 2018 /
 1 JAN 2019 /
/


DATES
 1 FEB 2019 /
/

DATES
 1 MAR 2019 /
 1 APR 2019 /
 1 MAY 2019 /
 1 JUN 2019 /
 1 JUL 2019 /
/

END
