-- This deck tests usage of reservoir coupling.

-- This case is a pure prediction case (no history). The master model includes one grid cell
-- and no wells. The master deck is used only for controlling production and injection
-- from the two slave models.

-- rc_m2/injcap: as rc_m2/t2a, with the water injection target of MOD1 lowered from 15000 to 1500
-- Sm3/d (GCONINJE below), so that it binds while the injection of C-1H (slave group MANI-C) ramps up
-- through 1500 Sm3/d from day 22.  MOD1's children are B1_M and D1_M (no injectors), C1_M (C-1H) and
-- F1_M (F-1H).  Tests how the master handles a master group whose slave injectors do not follow the
-- group's target (here C-1H, on its own BHP limit while it ramps up): the group is left out of its
-- parent's injection guide-rate distribution and the other groups take up the difference.  The slaves
-- are those of rc_m2/t2a.

------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
RUNSPEC
------------------------------------------------------------------------------------------------

INCLUDE
 '../../t2a/master/include/runspec.inc' /

------------------------------------------------------------------------------------------------
GRID
------------------------------------------------------------------------------------------------

INCLUDE
 '../../t2a/master/include/grid.inc' /

------------------------------------------------------------------------------------------------
EDIT
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
PROPS
------------------------------------------------------------------------------------------------

INCLUDE
 '../../t2a/master/include/props.inc' /

------------------------------------------------------------------------------------------------
REGIONS
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
SOLUTION
------------------------------------------------------------------------------------------------

INCLUDE
 '../../t2a/master/include/solution.inc' /

------------------------------------------------------------------------------------------------
SUMMARY
-----------------------------------------------------------------------------------------------

INCLUDE
 '../../t2a/master/include/summary.inc' /

INCLUDE
 '../../t2a/master/include/summary_groups.inc' /

------------------------------------------------------------------------------------------------
SCHEDULE
------------------------------------------------------------------------------------------------


-- Time step controls, VFP tables of the master network, and GRUPTREE
INCLUDE
 '../../t2a/master/include/schedule_start.inc' /

SLAVES
  'RES-1'  'T2A_MOD1_FLOW'   '*'  '../../t2a/mod1'  4 /
  'RES-2'  'T2A_MOD2_FLOW'   '*'  '../../t2a/mod2'  1 /
/

INCLUDE
 '../../t2a/master/include/grupmast.inc' /

BRANPROP
--  Downtree  Uptree	  #VFP  ALQ
    B1_M	'PLAT-A'    3   1* /
    D1_M	'PLAT-A'    4   1* /
    E1_M	'PLAT-A'    5	1* /
/

NODEPROP
--  Node_name  Press  autoChoke?  addGasLift?  Group_name
     PLAT-A	21.0   NO        NO	    1*  /
     B1_M	1*     NO	 NO	    1*  /
     D1_M	1*     NO	 NO	    1*  /
     E1_M	1*     NO	 NO	    1*  /
/

UDQ
 ASSIGN FUQOMAX 9000.0 /
/

DATES
 2 'OCT' 2018 /
/

DATES
 5 'OCT' 2018 /
/

DATES
 10 'OCT' 2018 /
/

DATES
 15 'OCT' 2018 /
/


GUIDERAT
 30.0 OIL 1.0 1.0 1* 1*  1.0  0.2  1*  0.1  /


GCONPROD
 'FIELD' 'ORAT'   FUQOMAX  1*  6.9E6   1*   'RATE'  /

 'D1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'B1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'C1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'F1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
 'E1_M'  'ORAT'   9200.0  1*  6.9E6   1*   'RATE'  1*  1*  'FORM'  /
/

GCONSUMP
  'FIELD'  200000 /
/

GCONINJE
-- 'FIELD' 'GAS'   'REIN'   4.0E6  1*  1.0  /
-- 'D1_M'  'GAS'   'RATE'   4.0E6  4*  1.0  'RATE' /
-- 'B1_M'  'GAS'   'RATE'   4.0E6  4*  1.0  'RATE' /
-- 'C1_M'  'GAS'   'RATE'   4.0E6  4*  1.0  'RATE' /
-- 'E1_M'  'GAS'   'RATE'   4.0E6  4*  1.0  'RATE' /
 'D1_M'  'WATER' 'RATE'   4.0E6  4*  1.0  'RATE' /
 'B1_M'  'WATER' 'RATE'   4.0E6  4*  1.0  'RATE' /

-- Lowered from 15000 so that the MOD1 water injection target binds while C-1H ramps up
 'MOD1'  'WATER' 'RATE' 1500.0 /

 'C1_M'  'WATER' 'NONE' 5* 0 'NETV' /
 'F1_M'  'WATER' 'NONE' 5* 0 'NETV' /

 'E1_M'  'WATER' 'RATE'   4.0E6  4*  1.0  'RATE' /

/

DATES
 19 'OCT' 2018 /
/

DATES
 20 'OCT' 2018 /
/


DATES
 1 NOV 2018 /
/


DATES
 1 DEC 2018 /
 1 JAN 2019 /
/


DATES
 1 FEB 2019 /
/

DATES
 1 MAR 2019 /
 1 APR 2019 /
 1 MAY 2019 /
 1 JUN 2019 /
 1 JUL 2019 /
/

END
