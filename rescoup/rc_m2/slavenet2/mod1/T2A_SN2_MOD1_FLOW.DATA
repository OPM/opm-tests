-- This deck is used for testing reservoir coupling.  It is the slave RES-1 of rc_m2/slavenet2, started
-- with the master deck TEST2A_SN2_FLOW.DATA.  As in rc_m2/slavenet, MANI-B and MANI-D are
-- fixed-pressure nodes of a network of its own, but the wells are in the groups WG-B and WG-D below
-- them.  The flowline VFP tables 13 and 14 of these groups (include/wgb_vfp_flowline.inc and
-- include/wgd_vfp_flowline.inc) are copies of the master's tables 3 and 4 with the table number
-- changed.  They are only there to give the branches a pressure drop.

RUNSPEC

INCLUDE
 '../../t2a/mod1/include/runspec.inc' /

-- slavenet2: this slave has a network of its own, see BRANPROP/NODEPROP in SCHEDULE.
NETWORK
 4 2 /

VFPPDIMS
 25  15  15  15  0  5 /

--------------------------------------------------------------------------------

GRID

INCLUDE
 '../../t2a/mod1/include/grid.inc' /

--------------------------------------------------------------------------------

EDIT

--------------------------------------------------------------------------------

