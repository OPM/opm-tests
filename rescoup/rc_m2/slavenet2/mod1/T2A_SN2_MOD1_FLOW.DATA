INCLUDE
 '../../t2a/mod1/include/summary.data' /

--
INCLUDE
 '../../../common/mod1/gas.inc' /


FUCOL

FUGIRC4H
FUGIRC5H

ROIP_COL
/

GGIRT
/

WMCTL
/

WUBHPWI
/

WUIWBP4
/

