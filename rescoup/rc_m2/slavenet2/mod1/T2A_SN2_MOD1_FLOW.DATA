SCHEDULE


INCLUDE
 '../../../common/mod1/B2H.Ecl' /

INCLUDE
 '../../../common/mod1/D1CH.Ecl' /

INCLUDE
 '../../../common/mod1/D2H.Ecl' /

INCLUDE
 'include/wgb_vfp_flowline.inc' /

INCLUDE
 'include/wgd_vfp_flowline.inc' /


GRUPTREE
 'PLAT-A'  'FIELD' /
 'MANI-B'  'PLAT-A'  /
 'WG-B'    'MANI-B'  /
 'MANI-D'  'PLAT-A'  /
 'WG-D'    'MANI-D'  /
 'MANI-C'  'PLAT-A'  /
 'MANI-F'  'PLAT-A'  /
/

GRUPSLAV
 'MANI-D'  'D1_M' /
 'MANI-B'  'B1_M' /
 'MANI-C'  'C1_M' /
 'MANI-F'  'F1_M' /
/

-- slavenet2: MANI-B and MANI-D are fixed-pressure nodes, as in rc_m2/slavenet, but the wells
-- are in the groups WG-B and WG-D below them, two nodes with a flowline branch (tables 13 and 14)
-- to the fixed-pressure node.  The node pressures the master sends for B1_M and D1_M are the
-- pressures of MANI-B and MANI-D, so the THP limits of the wells are those plus the pressure drop
-- in the branch.  The pressure of 25 bar is replaced by the master's pressure at every exchange.
BRANPROP
 WG-B  MANI-B  13  1* /
 WG-D  MANI-D  14  1* /
/

NODEPROP
 MANI-B  25.0  NO  NO  1* /
 MANI-D  25.0  NO  NO  1* /
 WG-B    1*    NO  NO  1* /
 WG-D    1*    NO  NO  1* /
/


WELSPECS
 'C-4H' 'MANI-C' 11 17 1* 'GAS' /
 'C-1H' 'MANI-C' 26 26 1* 'WATER' /
 'B-2H' 'WG-B' 15 13 2627.84 'OIL' 2* 'STOP' /
 'D-1H' 'WG-D' 22  4 2595.82 'OIL' 2* 'STOP' /
 'D-2H' 'WG-D' 14 10 2643.21 'OIL' 2* 'STOP' /
/

INCLUDE
 '../../t2a/mod1/include/completions.inc' /

-- The schedule from 1 to 20 Oct 2018, the same in all RES-1 decks of rc_m2. It ends with
-- the injection controls of C-4H, C-1H and F-1H, which hold for the rest of the run.
INCLUDE
 '../../t2a/mod1/include/schedule_oct2018.inc' /


WCONPROD
  'B-2H'  'OPEN'  'ORAT'  4000.0 1*  4.0E6 2*    1*  25.0  1   /
  'D-1H'  'OPEN'  'ORAT'  4000.0 1*  4.0E6 2*    1*  25.0  2   /
  'D-2H'  'OPEN'  'ORAT'  4000.0 1*  4.0E6 2*    1*  25.0  3   /
/


DATES
 1 NOV 2018 /
/


DATES
 1 DEC 2018 /
/

--WELOPEN
-- 'C-5H' 'OPEN' /
--/

NEXTSTEP
 1.0 /

WELOPEN
 'F-1H' 'OPEN' /
/


DATES
 1 JAN 2019 /
 1 FEB 2019 /
 1 MAR 2019 /
 1 APR 2019 /
 1 MAY 2019 /
 1 JUN 2019 /
 1 JUl 2019 /
/

END
