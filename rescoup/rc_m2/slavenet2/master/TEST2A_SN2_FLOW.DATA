INCLUDE
 '../../../common/master/b1_vfp_flowline.inc' /

INCLUDE
 '../../../common/master/d1_vfp_flowline.inc' /

INCLUDE
 '../../../common/master/flowline_e1_vfp.inc' /


--TSTEP
-- 1.0 /


GRUPTREE
 'PLAT-A' 'FIELD' /
 
 'MOD1'   'PLAT-A' /

 'B1_M'   'MOD1' /
 'D1_M'   'MOD1' /
 'C1_M'   'MOD1' /
 'F1_M'   'MOD1' /
 
 'E1_M'   'PLAT-A' /
/

SLAVES
  'RES-1'  'T2A_SN2_MOD1_FLOW'   '*'  '../mod1'  4 /
  'RES-2'  'T2A_MOD2_FLOW'   '*'  '../../t2a/mod2'  1 /
/

GRUPMAST
 'D1_M' 'RES-1'  'MANI-D'  1*  / 
 'B1_M' 'RES-1'  'MANI-B'  1*  / 
 'C1_M' 'RES-1'  'MANI-C'  1*  / 
 'F1_M' 'RES-1'  'MANI-F'  1*  / 
 'E1_M' 'RES-2'  'E1'  1*  / 
/

BRANPROP
--  Downtree  Uptree	  #VFP  ALQ
    B1_M	'PLAT-A'    3   1* /
    D1_M	'PLAT-A'    4   1* /
    E1_M	'PLAT-A'    5	1* /
/

-- slavenet2: PLAT-A is at 52 bar here (21 bar in t2a), so that the THP limits the
-- network imposes on the slave wells bind.
NODEPROP
--  Node_name  Press  autoChoke?  addGasLift?  Group_name
     PLAT-A	52.0   NO        NO	    1*  /
     B1_M	1*     NO	 NO	    1*  /
     D1_M	1*     NO	 NO	    1*  /
     E1_M	1*     NO	 NO	    1*  /
/

UDQ
 ASSIGN FUQOMAX 9000.0 /
/ 

DATES
 2 'OCT' 2018 /
/

DATES
 5 'OCT' 2018 /
/

DATES
 10 'OCT' 2018 /
/

DATES
 15 'OCT' 2018 /
/



