-- This deck is used for testing reservoir coupling.  It is the slave RES-1 of rc_m2/slavenet3, started
-- with the master deck TEST2A_SN3_FLOW.DATA.  As the slave RES-1 of rc_m2/slavenet, with the wells in
-- the groups MANI-B and MANI-D, but the network (NETWORK, BRANPROP and NODEPROP in the SCHEDULE section)
-- has only the branches from these nodes to FIELD, which has no pressure, so the network has no
-- root and its solution is empty.  The time step is limited to 1 day (TUNING), so that a sync step has
-- several time steps, of which only the first gets the pressures of the master.

RUNSPEC

INCLUDE
 '../../t2a/mod1/include/runspec.inc' /

-- slavenet3: this slave has a network of its own, see BRANPROP/NODEPROP in SCHEDULE.
NETWORK
 3 2 /

VFPPDIMS
 19  10  10  10  0  3 /

--------------------------------------------------------------------------------

GRID

INCLUDE
 '../../t2a/mod1/include/grid.inc' /

--------------------------------------------------------------------------------

EDIT

--------------------------------------------------------------------------------

PROPS

INCLUDE
 '../../t2a/mod1/include/props.inc' /

--------------------------------------------------------------------------------

REGIONS

INCLUDE
 '../../t2a/mod1/include/regions.inc' /

--------------------------------------------------------------------------------

SOLUTION

INCLUDE
 '../../t2a/mod1/include/solution.inc' /

--------------------------------------------------------------------------------

SUMMARY

NEWTON
MLINEARS

--
INCLUDE
 '../../t2a/mod1/include/summary.data' /

--
INCLUDE
 '../../../common/mod1/gas.inc' /


FUCOL

FUGIRC4H
FUGIRC5H

ROIP_COL
/

GGIRT
/

WMCTL
/

WUBHPWI
/

WUIWBP4
/

WPI4
/

WPI
/
WBP4
/

--------------------------------------------------------------------------------


SCHEDULE

TUNING
 0.5 1.0 /
 /
 /


INCLUDE
 '../../../common/mod1/B2H.Ecl' /

INCLUDE
 '../../../common/mod1/D1CH.Ecl' /

INCLUDE
 '../../../common/mod1/D2H.Ecl' /


GRUPTREE
 'PLAT-A'  'FIELD' /
 'MANI-B'  'PLAT-A'  /
 'MANI-D'  'PLAT-A'  /
 'MANI-C'  'PLAT-A'  /
 'MANI-F'  'PLAT-A'  /
/

GRUPSLAV
 'MANI-D'  'D1_M' /
 'MANI-B'  'B1_M' /
 'MANI-C'  'C1_M' /
 'MANI-F'  'F1_M' /
/

-- slavenet3: MANI-B and MANI-D are fixed-pressure nodes, so the node pressures the
-- master sends for B1_M and D1_M are applied as dynamic THP limits on their wells.
-- They are the downtree ends of the branches to FIELD, which has no pressure, so there
-- is no node to solve the network from (the table 9999 is not used).  The pressure of
-- 25 bar is replaced by the master's pressure at every exchange.
BRANPROP
 MANI-B  FIELD   9999  1* /
 MANI-D  FIELD   9999  1* /
/

NODEPROP
 MANI-B  25.0  NO  NO  1* /
 MANI-D  25.0  NO  NO  1* /
 FIELD   1*    NO  NO  1* /
/


WELSPECS
 'C-4H' 'MANI-C' 11 17 1* 'GAS' /
 'C-1H' 'MANI-C' 26 26 1* 'WATER' /
 'B-2H' 'MANI-B' 15 13 2627.84 'OIL' 2* 'STOP' /
 'D-1H' 'MANI-D' 22  4 2595.82 'OIL' 2* 'STOP' /
 'D-2H' 'MANI-D' 14 10 2643.21 'OIL' 2* 'STOP' /
/

INCLUDE
 '../../t2a/mod1/include/completions.inc' /

-- The schedule from 1 to 20 Oct 2018, the same in all RES-1 decks of rc_m2. It ends with
-- the injection controls of C-4H, C-1H and F-1H, which hold for the rest of the run.
INCLUDE
 '../../t2a/mod1/include/schedule_oct2018.inc' /


WCONPROD
  'B-2H'  'OPEN'  'ORAT'  4000.0 1*  4.0E6 2*    1*  25.0  1   /
  'D-1H'  'OPEN'  'ORAT'  4000.0 1*  4.0E6 2*    1*  25.0  2   /
  'D-2H'  'OPEN'  'ORAT'  4000.0 1*  4.0E6 2*    1*  25.0  3   /
/


DATES
 1 NOV 2018 /
/


DATES
 1 DEC 2018 /
/

--WELOPEN
-- 'C-5H' 'OPEN' /
--/

NEXTSTEP
 1.0 /

WELOPEN
 'F-1H' 'OPEN' /
/


DATES
 1 JAN 2019 /
 1 FEB 2019 /
 1 MAR 2019 /
 1 APR 2019 /
 1 MAY 2019 /
 1 JUN 2019 /
 1 JUl 2019 /
/

END
