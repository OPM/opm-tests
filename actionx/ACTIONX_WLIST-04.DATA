-- This deck tests ACTIONX and WLIST. Summary vector GLPR is used togehter
-- with well list.

-- GLPR '*GP_T2' => sum of well liquid rates, including efficiency factors.
 
-- This is available in ACTIONX condition and UDQ definitions. 

------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
RUNSPEC
------------------------------------------------------------------------------------------------

DIMENS
 6 5 7 /

OIL
WATER
GAS
DISGAS
VAPOIL

METRIC

START
 10 'OCT' 2018 /

--
GRIDOPTS
'YES'		0 / 


EQLDIMS
 1 1*  25 /


--
REGDIMS
-- max. ntfip  nmfipr  max. nrfreg   max. ntfreg
   1          4       1*            1*    /

--
--
WELLDIMS
--max.well  max.con/well  max.grup  max.w/grup
 5        10            10        10  6*  2  /

--
TABDIMS
--ntsfun     ntpvt  max.nssfun  max.nppvt  max.ntfip  max.nrpvt
  1          1      50          60         72         60 /

--
UDQDIMS 
 16 16 5 5 /

UDQPARAM 
 2*  33.33 / 
--
UNIFIN
UNIFOUT

--

------------------------------------------------------------------------------------------------
GRID
------------------------------------------------------------------------------------------------

--
NEWTRAN

--
GRIDFILE
0  1/

--
GRIDUNIT
METRES  /

--
INIT

INCLUDE
'include/mod2_6x5x7.grdecl' /

PORO
 30*0.25  30*0.22  30*0.17  30*0.28  30*0.14
 30*0.23  30*0.22 /
 
PERMX
 30*2100  30*1200  30*800  30*2500 30*10
 30*1700 30*1200 /

PERMZ
 30*210 30*120 30*80 30*250 30*1
 30*170 30*120 /

NTG
 30*0.95 30*0.88 30*0.85 30*0.70 30*0.14
 30*0.77 30*0.82 /

COPY
 PERMX PERMY /
/

RPTGRID
 'ALLNNC' /


------------------------------------------------------------------------------------------------
PROPS
------------------------------------------------------------------------------------------------

NOECHO


INCLUDE
'include/PVT-WET-GAS.INC' /


INCLUDE
 'include/scal_mod2.inc' /


------------------------------------------------------------------------------------------------
REGIONS
------------------------------------------------------------------------------------------------

EQLNUM
 210*1 /
 
SATNUM
 210*1 /


------------------------------------------------------------------------------------------------
SOLUTION
------------------------------------------------------------------------------------------------

RPTSOL
SWAT FIP=3 THPRES EQUIL RECOV FIPRESV /

RPTRST
 BASIC=2 /

EQUIL
-- Datum    P     woc     Pc    goc      Pc  Rsvd Rvvd  N
 2550.0   270.0  2550.0   0.0  1500.00  0.0   1   1    0 /  



PDVD
    0.0   250.8
 1500.0   250.8 /

PBVD
 2500.0   250.8
 2550.0   243.0  / 

------------------------------------------------------------------------------------------------
SUMMARY
------------------------------------------------------------------------------------------------

WBHP
/

WOPR
/

WGPR
/

WGOR
/

WWCT
/

WWPR
/

WLPR
/

FULPR_T2

GEFF
/

WEFF
/

WEFFG
/

GGPR
/

FOPR

FGPR

FGOR

FPR

GGOR
/

GWPR
/

GWCT
/

GLPR
/

WMCTL
/


WWIR
/

WLPR
/


------------------------------------------------------------------------------------------------
SCHEDULE
------------------------------------------------------------------------------------------------

TUNING
 1 1 /
 /
 /
   
GRUPTREE
 'PROD'  'FIELD' /
 'TEST'  'PROD' /
/  
   
-- start: 10  'OCT' 2018 /

WELSPECS 
   'D-1H'   'TEST'   2   2  1*       'OIL'  2*      'STOP'  4* /
   'D-2H'   'TEST'   1   4  1*       'OIL'  2*      'STOP'  4* /
   'D-3H'   'TEST'   5   1  1*       'OIL'  2*      'STOP'  4* /
   'F-1H'   'TEST'   6   5  1*       'WATER'  2*      'STOP'  4* /
/

COMPDAT 
-- WELL     I   J  K1   K2            Sat.   CF     DIAM   KH SKIN ND  DIR   Ro 
   'D-1H'   2	2   1	4      'OPEN'  1*     1*    0.216   3*         'Z'   1* /
   'D-2H'   1	4   1	4      'OPEN'  1*     1*    0.216   3*         'Z'   1* /
   'D-3H'   5	1   1	3      'OPEN'  1*     1*    0.216   3*         'Z'   1* /
   'F-1H'   6	5   4	7      'OPEN'  1*     1*    0.216   3*         'Z'   1* /
/

WCONPROD
 'D-1H' 'OPEN'  'ORAT'  1200.0 1*  425000 2* 75.0 /
 'D-2H' 'OPEN'  'ORAT'  1200.0 1*  425000 2* 75.0 /
 'D-3H' 'OPEN'  'ORAT'  1200.0 1*  425000 2* 75.0 /
/

GCONINJE
 'TEST'  'WATER'  'VREP'   7000.0  2*  1.005 /
/
 
WCONINJE
 'F-1H'  'WATER'  'OPEN'  'RATE'  7000.0  1*  425 /
/
 
WLIST
 '*GP_T1' 'NEW' 'D-2H' 'D-3H' /
 '*GP_T2' 'NEW' 'D-1H' 'D-2H' 'D-3H' /
/

WEFAC
 'D-1H'  0.84/
 'D-2H'  0.87 /
 'D-3H'  0.91 /
/

UDQ
 DEFINE 'FUTIME1' TIME  /
 DEFINE 'FULPR_T2' GLPR '*GP_T2'  / 
/

ACTIONX
 'TEST1' 10 25 /
 FUTIME1 > 5.0 AND /
 GLPR '*GP_T2' > 2800.0 /
/

WELOPEN
 'D-3H' 'SHUT'  /
/

ENDACTIO

  
DATES
 1 NOV 2018 /
 1 DEC 2018 /
 1 JAN 2019 /
/


END
