-- -------------------------------------------------------------------------------------------------------
-- Extended network test case for GSATPROD and GCONSUMP, based on NETWORK-01.
--
-- Group tree and extended network:
--
--     FIELD   (fixed node pressure 80 barsa)
--       |  branch PLAT -> FIELD, VFP 2
--     PLAT    (platform node, GCONSUMP gas consumption)
--       |----------------------------.
--       |  branch PROD -> PLAT, VFP 2  |  branch SAT -> PLAT, VFP 2
--     PROD    (wells PROD1-3)        SAT  (satellite group, GSATPROD, no wells)
--
--     INJE    (water injectors, not part of the network)
--
-- Schedule events:
--   01 DEC 2018: PROD1/PROD2 open on THP-limited group control.  The
--                satellite group SAT produces via GSATPROD and its rates flow
--                through branch SAT->PLAT and then branch PLAT->FIELD.
--   15 DEC 2018: GCONSUMP removes 2.5E5 sm3/d gas at PLAT.  PLAT is not a
--                source node, so GCONSUMP item 4 names node PLAT explicitly
--                (a defaulted item 4 would not affect the network).  The gas
--                rate is reduced in branch PLAT->FIELD only.
--   01 JAN 2019: SAT starts receiving 1.0E5 sm3/d lift gas (GSATPROD item 6),
--                which NODEPROP item 4 adds to the gas rate at node SAT.
--   05 JAN 2019: PROD3 opens.  GCONSUMP removes 1.0E5 sm3/d gas at the
--                source node PROD (item 4 defaulted), which reduces the gas
--                rate in branches PROD->PLAT and PLAT->FIELD.
--   01 FEB 2019: Wells switch to 1000 sm3/d ORAT, no longer network limited.
--   15 FEB 2019: GCONSUMP item 4 for PLAT set to 'NO-NODES', i.e. PLAT's
--                consumption no longer affects the network.
--
-- Expected network gas rates (GGCR:PLAT includes PROD's consumption):
--   15 DEC 2018 - 05 JAN 2019:
--     GGPRNB:PROD = GGPR:PROD
--     GGPRNB:PLAT = GGPRNB:PROD + GGPRNB:SAT - 2.5E5
--   05 JAN 2019 - 15 FEB 2019:
--     GGPRNB:PROD = GGPR:PROD - 1.0E5
--     GGPRNB:PLAT = GGPRNB:PROD + GGPRNB:SAT - 2.5E5
--   15 FEB 2019 onwards:
--     GGPRNB:PROD = GGPR:PROD - 1.0E5
--     GGPRNB:PLAT = GGPRNB:PROD + GGPRNB:SAT
--
-- Effect of the consumption at PLAT at 15 DEC 2018 (wells THP limited):
--   lower GOR in branch PLAT->FIELD.  VFP 2 is hydrostatically dominated
--   (datum depth 114.6 m), so the heavier fluid gives a LARGER pressure drop
--   PLAT->FIELD (about 10.3 -> 10.8 bar) => higher GPR:PLAT and GPR:PROD
--   => higher WTHP:PROD1/2 => lower WOPR/WGPR:PROD1/2.
-- -------------------------------------------------------------------------------------------------------
RUNSPEC
---------------------------------------------------------------------------------------------------------


DIMENS
 13 22 11 /


OIL
WATER
GAS
DISGAS
VAPOIL

METRIC

START
 01  'NOV' 2018 /

NSTACK
  50 /

--
GRIDOPTS
 'YES'	      0 /

EQLDIMS
 2 1*  25 /


EQLOPTS
 THPRES  /


REGDIMS
-- max. ntfip  nmfipr  max. nrfreg   max. ntfreg
   2          1       1*            2    /

--
WELLDIMS
--max.well  max.con/well  max.grup  max.w/grup
 10	    15 	          6	     10   /

--
TABDIMS
--ntsfun     ntpvt  max.nssfun  max.nppvt  max.ntfip  max.nrpvt
  10          1      50          60         2         60 /


VFPPDIMS
--max.rate  max.THP   max.fw   max.fg	max.ALQ    max.tabs
  40	    20        20       20	 13	    60	    /

--
FAULTDIM
120 / max. number os fault segments

NETWORK
  5  5  /

UNIFIN
UNIFOUT

