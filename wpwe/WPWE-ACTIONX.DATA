-- Convert B-1H in both directions inside one ten-day report interval.
-- WPWE6 must accompany the first injecting timestep and WPWE5 the return
-- to production. Neither event may be delayed to the next report interval.

INCLUDE
 'include/wpwe-model.inc' /

SUMMARY
INCLUDE
 'include/wpwe-summary.inc' /

SCHEDULE
TUNING
 0.1 1.0 1.0e-4 /
 /
 /

INCLUDE
 'include/wpwe-wells.inc' /

ACTIONX
 'TOINJ' 1 /
 TIME > 1 /
/
WCONINJE
 'B-1H' 'WATER' 'OPEN' 'RATE' 100.0 1* 400.0 /
/
ENDACTIO

ACTIONX
 'TOPROD' 1 /
 TIME > 5 /
/
WCONPROD
 'B-1H' 'OPEN' 'ORAT' 1500.0 4* 100.0 /
/
ENDACTIO

TSTEP
 10 /
TSTEP
 2 /
END
