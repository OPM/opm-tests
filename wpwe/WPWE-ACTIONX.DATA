-- Convert B-1H to injection mid-run and back again, each time in the middle
-- of a monthly report interval.  WPWE6 must accompany the first injecting
-- timestep and WPWE5 the return to production, neither of them deferred to
-- the report boundary that follows.

INCLUDE
 'include/wpwe-model.inc' /

SUMMARY
INCLUDE
 'include/wpwe-summary.inc' /

SCHEDULE
TUNING
 2.0 3.0 1.0e-4 /
 /
 /

INCLUDE
 'include/wpwe-wells.inc' /

ACTIONX
 'TOINJ' 1 /
 TIME > 45 /
/
WCONINJE
 'B-1H' 'WATER' 'OPEN' 'RATE' 100.0 1* 400.0 /
/
ENDACTIO

ACTIONX
 'TOPROD' 1 /
 TIME > 115 /
/
WCONPROD
 'B-1H' 'OPEN' 'ORAT' 1500.0 4* 100.0 /
/
ENDACTIO

DATES
  30 'AUG' 2020 /
/
END
