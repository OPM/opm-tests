-- All connections closed overrides STOP policy: B-1H must report WPWE7.
-- A whole-well workover with crossflow allowed stops B-3H (WPWE4).
-- Disallowing crossflow forces C-1H shut (WPWE7), despite its STOP policy.

INCLUDE
 'include/wpwe-model.inc' /

SUMMARY
INCLUDE
 'include/wpwe-summary.inc' /

SCHEDULE
TUNING
 2.0 3.0 1.0e-4 /
 /
 /

INCLUDE
 'include/wpwe-wells.inc' /

WELSPECS
-- WELL   GROUP I J DEPTH PHASE DRAD INFEQ SIINS XFLOW
 'B-1H' 'B1' 15 3  1* 'OIL' 2* 'STOP' 'YES' /
 'B-3H' 'B1' 14 12 1* 'OIL' 2* 'STOP' 'YES' /
 'C-1H' 'C1' 13 20 1* 'OIL' 2* 'STOP' 'NO' /
/

CECON
 'B-1H' 2* 1 4 0.6 2* 'CON' /
 'B-3H' 2* 1 4 0.6 2* 'WELL' /
 'C-1H' 2* 1 5 0.6 2* 'WELL' /
/

DATES
  18 'MAY' 2020 /
/
END
