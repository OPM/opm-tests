-- WPWE0, the drilled indicator.  Flow supports neither QDRILL nor WDRILPRI,
-- so the drilling queue cannot be modelled; the closest available reading is
-- a well that the schedule introduces through WELSPECS while the run is under
-- way.  B-1H, B-2H and B-3H exist from the start and must never report WPWE0.
-- C-1H arrives in February and C-2H in April, and each must report WPWE0 = 1
-- on the timestep it appears and zero afterwards.
--
-- Whether a simulator also reports the wells present at time zero is the open
-- question: Flow does not, on the grounds that they were never drilled during
-- the run.

INCLUDE
 'include/wpwe-model.inc' /

SUMMARY
INCLUDE
 'include/wpwe-summary.inc' /

SCHEDULE
TUNING
 2.0 3.0 1.0e-4 /
 /
 /

WELSPECS
--WELL     GROUP  IHEEL JHEEL   DREF PHASE   DRAD INFEQ SIINS XFLOW
 'B-1H'  'B1'  15    3      1*   OIL     1*   1*   SHUT 1* 1* 1* /
 'B-2H'  'B1'   8    7      1*   OIL     1*   1*   SHUT 1* 1* 1* /
 'B-3H'  'B1'  14   12      1*   OIL     1*   1*   SHUT 1* 1* 1* /
/

COMPDAT
 'B-1H'    15    3    1    4   OPEN    1*      1*    0.216    1*  0    1*    Z     1* /
 'B-2H'     8    7    1    6   OPEN    1*      1*    0.216    1*  0    1*    Z     1* /
 'B-3H'    14   12    1    5   OPEN    1*      1*    0.216    1*  0    1*    Z     1* /
/

WCONPROD
   'B-1H'      OPEN    ORAT  1500.0   1*    1*    1*     1*   100.0  1*   1*  1*  /
   'B-2H'      OPEN    ORAT  1500.0   1*    1*    1*     1*   100.0  1*   1*  1*  /
   'B-3H'      OPEN    ORAT  1500.0   1*    1*    1*     1*   100.0  1*   1*  1*  /
/

DATES
  01 'FEB' 2020 /
/

-- C-1H is drilled.
WELSPECS
 'C-1H'  'C1'  13   20      1*   OIL     1*   1*   SHUT 1* 1* 1* /
/
COMPDAT
 'C-1H'    13   20    1    5   OPEN    1*      1*    0.216    1*  0    1*    Z     1* /
/
WCONPROD
   'C-1H'      OPEN    ORAT  1500.0   1*    1*    1*     1*   100.0  1*   1*  1*  /
/

DATES
  01 'MAR' 2020 /
  01 'APR' 2020 /
/

-- C-2H is drilled.
WELSPECS
 'C-2H'  'C1'  13   28      1*   OIL     1*   1*   SHUT 1* 1* 1* /
/
COMPDAT
 'C-2H'    13   28    1    5   OPEN    1*      1*    0.216    1*  0    1*    Z     1* /
/
WCONPROD
   'C-2H'      OPEN    ORAT  1500.0   1*    1*    1*     1*   100.0  1*   1*  1*  /
/

DATES
  01 'MAY' 2020 /
  01 'JUN' 2020 /
  01 'JUL' 2020 /
  07 'JUL' 2020 /
/
END
