-- Does WPWE3 care what closed the other connections?  A well whose closures
-- come from a mixture of causes is the discriminating case.
--
--   C-1H  connections 1 to 3 shut from the deck, 4 and 5 closed by CON
--         workovers.  Closing connection 5 leaves the well flowing on 4 with
--         three shut above it, which is not closed to the bottom and reports
--         no WPWE3.  Closing 4 as well gives WPWE2, WPWE3 and WPWE7 at day 91.
--   B-1H  every connection closed by CON workovers, reporting WPWE3 at day 40
--         when only the topmost is left and again with WPWE7 at day 75.
--
-- So the cause does not matter, but the geometry does: what counts is whether
-- the closures left the well on its topmost completion, or on nothing.

INCLUDE
 'include/wpwe-model.inc' /

SUMMARY
INCLUDE
 'include/wpwe-summary.inc' /

SCHEDULE
TUNING
 2.0 3.0 1.0e-4 /
 /
 /

INCLUDE
 'include/wpwe-wells.inc' /

-- Initial state: C-1H keeps only its two lower connections.
WELOPEN
 'C-1H' 'SHUT' 13 20 1 2* /
 'C-1H' 'SHUT' 13 20 2 2* /
 'C-1H' 'SHUT' 13 20 3 2* /
/

CECON
 'C-1H' 2* 4 5 0.6 2* 'CON' /
 'B-1H' 2* 1 4 0.6 2* 'CON' /
/

DATES
  01 'FEB' 2020 /
  01 'MAR' 2020 /
  01 'APR' 2020 /
  01 'MAY' 2020 /
  01 'JUN' 2020 /
  01 'JUL' 2020 /
/
END
