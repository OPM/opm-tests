-- Do the indicators reach a UDQ and an ACTIONX condition without being
-- requested in SUMMARY at all?  Do not include wpwe-summary.inc or add WPWE
-- vectors to SUMMARY here: that is the point of the deck.
--
--   FUEVENT  a UDQ DEFINE on WPWE2, which spikes on each of B-1H's four CON
--            closures, days 7.1, 19.1, 40 and 72.
--   FUFIRE   an ACTIONX on the same condition, latching from day 10.1.
--
-- The UDQ form is portable; using WPWE2 directly in an ACTIONX condition is
-- Flow-specific.  Its result does not depend on the missing SUMMARY request:
-- requesting WPWE2 does not change it.

INCLUDE
 'include/wpwe-model.inc' /

SUMMARY
FUEVENT
FUFIRE
WOPR
 'B-1H'
/

SCHEDULE
TUNING
 2.0 3.0 1.0e-4 /
 /
 /

INCLUDE
 'include/wpwe-wells.inc' /

CECON
 'B-1H' 2* 1 4 0.6 2* 'CON' /
/

UDQ
 DEFINE FUEVENT WPWE2 'B-1H' > 0 /
 UNITS FUEVENT 'Constant' /
 ASSIGN FUFIRE 0 /
 UNITS FUFIRE 'Constant' /
/

ACTIONX
 'ONCON' 1 /
 WPWE2 'B-1H' > 0 /
/
UDQ
 ASSIGN FUFIRE 1 /
/
ENDACTIO

DATES
  01 'FEB' 2020 /
  01 'MAR' 2020 /
  01 'APR' 2020 /
  01 'MAY' 2020 /
  24 'MAY' 2020 /
/
END
