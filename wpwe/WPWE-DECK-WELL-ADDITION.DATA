-- WPWE0 is the drilled indicator.  It reports a well taken off the drilling
-- queue defined by QDRILL and WDRILTIM.  Flow does not accept QDRILL, so the
-- indicator is not supported yet and the vectors read zero throughout.
--
-- What can be tested without a queue is that the closest observable case is
-- not a drilling event: B-1H, B-2H and B-3H exist from the start, C-1H arrives
-- through WELSPECS in February and C-2H in April, and none of them reports
-- WPWE0.  A well entering the schedule while the run is under way does not
-- count as a drilling event.  The vectors are present for all five wells, so a
-- run that emitted no WPWE0 vectors would still be distinguishable.

INCLUDE
 'include/wpwe-model.inc' /

SUMMARY
INCLUDE
 'include/wpwe-summary.inc' /

SCHEDULE
TUNING
 2.0 3.0 1.0e-4 /
 /
 /

WELSPECS
--WELL     GROUP  IHEEL JHEEL   DREF PHASE   DRAD INFEQ SIINS XFLOW
 'B-1H'  'B1'  15    3      1*   OIL     1*   1*   SHUT 1* 1* 1* /
 'B-2H'  'B1'   8    7      1*   OIL     1*   1*   SHUT 1* 1* 1* /
 'B-3H'  'B1'  14   12      1*   OIL     1*   1*   SHUT 1* 1* 1* /
/

COMPDAT
 'B-1H'    15    3    1    4   OPEN    1*      1*    0.216    1*  0    1*    Z     1* /
 'B-2H'     8    7    1    6   OPEN    1*      1*    0.216    1*  0    1*    Z     1* /
 'B-3H'    14   12    1    5   OPEN    1*      1*    0.216    1*  0    1*    Z     1* /
/

WCONPROD
   'B-1H'      OPEN    ORAT  1500.0   1*    1*    1*     1*   100.0  1*   1*  1*  /
   'B-2H'      OPEN    ORAT  1500.0   1*    1*    1*     1*   100.0  1*   1*  1*  /
   'B-3H'      OPEN    ORAT  1500.0   1*    1*    1*     1*   100.0  1*   1*  1*  /
/

DATES
  01 'FEB' 2020 /
/

-- C-1H enters the schedule.
WELSPECS
 'C-1H'  'C1'  13   20      1*   OIL     1*   1*   SHUT 1* 1* 1* /
/
COMPDAT
 'C-1H'    13   20    1    5   OPEN    1*      1*    0.216    1*  0    1*    Z     1* /
/
WCONPROD
   'C-1H'      OPEN    ORAT  1500.0   1*    1*    1*     1*   100.0  1*   1*  1*  /
/

DATES
  01 'MAR' 2020 /
  01 'APR' 2020 /
/

-- C-2H enters the schedule.
WELSPECS
 'C-2H'  'C1'  13   28      1*   OIL     1*   1*   SHUT 1* 1* 1* /
/
COMPDAT
 'C-2H'    13   28    1    5   OPEN    1*      1*    0.216    1*  0    1*    Z     1* /
/
WCONPROD
   'C-2H'      OPEN    ORAT  1500.0   1*    1*    1*     1*   100.0  1*   1*  1*  /
/

DATES
  01 'MAY' 2020 /
  01 'JUN' 2020 /
  01 'JUL' 2020 /
  07 'JUL' 2020 /
/
END
