-- Does a deck-driven status change or type conversion count as a WPWE event?
-- No CECON, no WTEST: every status change below comes from the SCHEDULE
-- section alone, so any nonzero indicator is deck-driven.
--
--   B-1H  WELOPEN SHUT              -> silent
--   B-2H  WCONPROD STOP             -> silent
--   B-3H  producer becomes injector -> WPWE6 = 1 at day 34
--   C-1H  injector becomes producer -> WPWE5 = 1 at day 34
--
-- The asymmetry is real: a deck-driven status change is not an event, while a
-- type conversion is.  WPWE4 and WPWE7 denote the simulator's own decisions,
-- and a conversion has no other source than the schedule or ACTIONX.

INCLUDE
 'include/wpwe-model.inc' /

SUMMARY
INCLUDE
 'include/wpwe-summary.inc' /

SCHEDULE
TUNING
 2.0 3.0 1.0e-4 /
 /
 /

INCLUDE
 'include/wpwe-wells.inc' /

-- C-1H starts on injection so that its change below is a genuine
-- injector to producer conversion.
WCONINJE
 'C-1H' 'WATER' 'OPEN' 'RATE' 1000.0 1* 400.0 /
/

-- Produce for a month first, so the deck acts on flowing wells.
DATES
  01 'FEB' 2020 /
/


WELOPEN
 'B-1H' 'SHUT' /
/

WCONPROD
 'B-2H' 'STOP' 'ORAT' 1500.0 4* 100.0 /
/

WCONINJE
 'B-3H' 'WATER' 'OPEN' 'RATE' 1000.0 1* 400.0 /
/

WCONPROD
 'C-1H' 'OPEN' 'ORAT' 1500.0 4* 100.0 /
/

DATES
  01 'MAR' 2020 /
  09 'MAR' 2020 /
/
END
