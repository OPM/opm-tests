-- Open question: are WPWE1 and WPWE2 counts of connections or of completions?
-- The manual says "the number of connections", but the workover that closes
-- them acts on a completion, and COMPLUMP lets one completion span several
-- connections.
--
--   B-1H  COMPLUMP lumps its four connections into two completions.  A CON
--         workover closes completion 2, i.e. two connections at once:
--         WPWE2 = 2 counts connections, WPWE2 = 1 counts completions.
--   C-1H  no COMPLUMP, one connection closed -> WPWE2 = 1 either way, so the
--         well shows the workover fired at all.

INCLUDE
 'include/wpwe-model.inc' /

SUMMARY
INCLUDE
 'include/wpwe-summary.inc' /

SCHEDULE
TUNING
 2.0 3.0 1.0e-4 /
 /
 /

INCLUDE
 'include/wpwe-wells.inc' /

COMPLUMP
--WELL      I  J K1 K2 N
 'B-1H'    15  3  1  2  1 /
 'B-1H'    15  3  3  4  2 /
/

CECON
 'B-1H' 2* 3 4 0.6 2* 'CON' /
 'C-1H' 2* 5 5 0.6 2* 'CON' /
/

DATES
  27 'JAN' 2020 /
/
END
