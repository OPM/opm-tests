-- Which of WPWE4 and WPWE7 does a workover-closed well report?
--
--   B-1H  CON workovers take its four connections on days 7.1, 19.1, 40 and
--         69.  Nothing is left to flow through, so the last of them reports
--         WPWE7 whatever the WELSPECS shut-in instruction says.
--   B-3H  a whole-well workover, crossflow allowed  -> WPWE4 at day 28.1
--   C-1H  a whole-well workover, crossflow disallowed -> WPWE4 at day 10.1
--
-- Both whole-well workover cases use the STOP shut-in instruction and report
-- WPWE4.  Disallowing crossflow does not change the indicator: with open
-- connections remaining, the workover stops the well rather than shutting it.

INCLUDE
 'include/wpwe-model.inc' /

SUMMARY
INCLUDE
 'include/wpwe-summary.inc' /

SCHEDULE
TUNING
 2.0 3.0 1.0e-4 /
 /
 /

INCLUDE
 'include/wpwe-wells.inc' /

WELSPECS
-- WELL   GROUP I J DEPTH PHASE DRAD INFEQ SIINS XFLOW
 'B-1H' 'B1' 15 3  1* 'OIL' 2* 'STOP' 'YES' /
 'B-3H' 'B1' 14 12 1* 'OIL' 2* 'STOP' 'YES' /
 'C-1H' 'C1' 13 20 1* 'OIL' 2* 'STOP' 'NO' /
/

CECON
 'B-1H' 2* 1 4 0.6 2* 'CON' /
 'B-3H' 2* 1 4 0.6 2* 'WELL' /
 'C-1H' 2* 1 5 0.6 2* 'WELL' /
/

DATES
  01 'FEB' 2020 /
  01 'MAR' 2020 /
  01 'APR' 2020 /
  01 'MAY' 2020 /
  18 'MAY' 2020 /
/
END
