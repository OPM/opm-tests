-- Test model for MINPV and PINCH + NOGAP. Grid with dimension 1x2x50. 

-- There are 30 inactive layers between cell 1,2,19 and cell 1,2,50. These cells are made
-- inactive with keyword ACTNUM.

-- The actual gap between bottom layer 1,2,9 and top cell 1,2,50 varies along the four 
-- pillars

--     4342.5991  4317.6821  4343.1499  4323.3682 
--     4354.7778  4345.9678  4343.4502  4331.6069 

--       12.1787    28.2856     0.3003     8.2388 


-- ==========================================================================================
RUNSPEC
-- ==========================================================================================

NOECHO


TITLE                                  
 Test model Pinch and NOGAP

DIMENS
  1 2 50  /

START                                  
  3 JAN 1971 /

OIL                                    
WATER                                  
GAS                                    
DISGAS                                 

METRIC                                 


--Table dimensions
TABDIMS
-- NTSFUN NTPVT NSSFUN NPPVT NTFIP NRPVT
     1      1     130    24    1    20   /


EQLDIMS                                
   1 /

-- Well dimension data
-- nwmaxz: max wells in the model
-- ncwmax: max connections per well
-- ngmaxz: max groups in the model

WELLDIMS                               
-- nwmaxz  ncwmax  ngmaxz  nwgmax 
   1       5       3      1       /    


UNIFIN
UNIFOUT


-- ==========================================================================================
GRID
-- ==========================================================================================


PINCH
 1.0 'NOGAP' /

MINPV 
 1  / 

GRIDFILE
 0 1 /

INIT

INCLUDE                                
 './include/grid_t1.grdecl'/

INCLUDE 			       
 './include/grid_t1.actnum'/

EQUALS
 'PORO'  0.25 /
 'PERMX'  2000.0  /
 'PERMZ'  200.0  /
/

COPY
 PERMX PERMY /
/

EQUALS
 'PORO'  0.0 1 1  1 1  30 50 /
 'PORO'  0.0 1 1  2 2   1 18 /
/ 


-- ==========================================================================================
PROPS
-- ==========================================================================================

INCLUDE
 './include/sgof.txt' /

INCLUDE
 './include/swof.txt' /

INCLUDE
  './include/example_pvt.txt' /


-- ==========================================================================================
SOLUTION
-- ==========================================================================================


EQUIL
--DEPTH   PRESS.   OWC     PCOW   GOC    PCGO  RS   RV   N
   4344    450.0   4400.0  0      2700    0.0   1    0   0 /


RSVD
  4300         120.0
  4400         120.0
 /


-- =========================================================================================
SUMMARY
-- =========================================================================================

TCPU

TIMESTEP

RPR
/

WOPR
/

WBHP
/

WGOR
/


BPR
 1 2 50 /
/ 

-- =========================================================================================
SCHEDULE
-- =========================================================================================

RPTRST
 'BASIC=2' /


WELSPECS
 'A-1H' 'PROD' 1 1 1* 'OIL' /
/


GRUPTREE
  'PROD'     'FIELD'  /
/

COMPDAT
 'A-1H' 1 1 1 1 OPEN 1*  1* 0.219 1* 0.0 1* 'Z'  /
 'A-1H' 1 1 2 2 OPEN 1*  1* 0.219 1* 0.0 1* 'Z'  /
 'A-1H' 1 1 3 3 OPEN 1*  1* 0.219 1* 0.0 1* 'Z'  /
 'A-1H' 1 1 4 4 OPEN 1*  1* 0.219 1* 0.0 1* 'Z'  /
/

WCONPROD
--WELL      OP/SH   CTL       ORAT       WRAT    GRAT     LRAT     RRAT        BHP        THP   VFP        ALQ
 'A-1H'      OPEN  ORAT       200         1*      1*       1*       1*        120         1*     1* 	 1* /
/

TSTEP
 2*0.5 4*1.0 /
 

END

