-- This model tests that a subgroup switched from NONE to its own water
-- injection RATE limit, with its wells back on individual control, is not
-- released to FLD while its guide rate share of the parent target is ample,
-- also when sibling groups participate in the guide rate distribution.
--
-- Group tree:  FIELD - TOP - PRODG            (producer PROD)
--                         - INJG - SUBA       (injector  INJA1)
--                                - SUBB       (injector  INJB1, GRUP)
--                                - SUBC       (injector  INJC1, GRUP)
--
-- SUBA, SUBB and SUBC have equal water injection guide rates.
--
-- Phase 1 (day   0- 60): INJA1 on BHP injects above SUBA's 100 limit
--                        -> SUBA switches NONE -> RATE, INJA1 -> GRUP.
-- Phase 2 (day  60-120): INJA1 reset to individual RATE 50. SUBA's share
--                        of the TOP target (1000) is ample, so SUBA stays
--                        on RATE, and SUBB and SUBC share the remainder.
-- Phase 3 (day 120-200): TOP water injection target set to 0.
--                        Expected: all injection stops, i.e. INJA1
--                        switches to GRUP and SUBA is released to FLD.

RUNSPEC

TITLE
GCONINJE SUBGROUP LATCH WITH GUIDE RATES

DIMENS
 10 10 3 /

OIL
WATER

METRIC

START
 1 JAN 2030 /

WELLDIMS
 5 3 6 5 /

TABDIMS
 1 1 20 20 /

UNIFOUT

GRID

INIT

DX
 300*100 /
DY
 300*100 /
DZ
 300*10 /
BOX
 1 10 1 10 1 1 /
TOPS
 100*2000 /
ENDBOX
PORO
 300*0.25 /
PERMX
 300*100 /
PERMY
 300*100 /
PERMZ
 300*10 /

PROPS

PVTW
 250 1.0 4.0E-5 0.5 0 /

PVDO
 100 1.10 1.0
 200 1.07 1.05
 400 1.04 1.10 /

DENSITY
 850 1000 1 /

ROCK
 250 5.0E-5 /

SWOF
 0.20 0.00 1.00 0
 0.30 0.02 0.70 0
 0.50 0.15 0.30 0
 0.70 0.40 0.05 0
 0.80 0.60 0.00 0 /

SOLUTION

EQUIL
 2000 250 2100 0 1900 0 /

SUMMARY

FOPR
FWIR
FWPR
FPR
GWIR
 TOP INJG SUBA SUBB SUBC /
GMCTW
 TOP INJG SUBA SUBB SUBC /
WWIR
 /
WMCTL
 /
WBHP
 /

SCHEDULE

RPTRST
 BASIC=2 /

GRUPTREE
 'TOP'   'FIELD' /
 'PRODG' 'TOP'   /
 'INJG'  'TOP'   /
 'SUBA'  'INJG'  /
 'SUBB'  'INJG'  /
 'SUBC'  'INJG'  /
/

WELSPECS
 'PROD'  'PRODG'  5  5 1* 'OIL'   /
 'INJA1' 'SUBA'   1  1 1* 'WATER' /
 'INJB1' 'SUBB'   1 10 1* 'WATER' /
 'INJC1' 'SUBC'  10 10 1* 'WATER' /
/

COMPDAT
 'PROD'  2* 1 3 'OPEN' 2* 0.2 /
 'INJA1' 2* 1 3 'OPEN' 2* 0.2 /
 'INJB1' 2* 1 3 'OPEN' 2* 0.2 /
 'INJC1' 2* 1 3 'OPEN' 2* 0.2 /
/

WCONPROD
 'PROD' 'OPEN' 'BHP' 5* 150 /
/

GCONINJE
 'TOP'  'WATER' 'RATE' 1000 /
 'SUBA' 'WATER' 'NONE'  100 3* 'YES' 1 'RATE' /
 'SUBB' 'WATER' 'FLD'   4*     'YES' 1 'RATE' /
 'SUBC' 'WATER' 'FLD'   4*     'YES' 1 'RATE' /
/

-- Phase 1: INJA1 limited by BHP only -> SUBA exceeds its 100 limit
WCONINJE
 'INJA1' 'WATER' 'OPEN' 'BHP'  5000 1* 300 /
 'INJB1' 'WATER' 'OPEN' 'GRUP' 5000 1* 400 /
 'INJC1' 'WATER' 'OPEN' 'GRUP' 5000 1* 400 /
/

TSTEP
 6*10 /

-- Phase 2: INJA1 back on individual rate control, below SUBA's limit
WCONINJE
 'INJA1' 'WATER' 'OPEN' 'RATE' 50 1* 300 /
/

TSTEP
 6*10 /

-- Phase 3: stop all water injection via the top group target
GCONINJE
 'TOP' 'WATER' 'RATE' 0 /
/

TSTEP
 8*10 /

END
