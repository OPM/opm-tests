-- This model is the gas injection counterpart of GCONINJE-04. It tests that
-- a subgroup switched from NONE to its own gas injection RATE limit, with its
-- gas injector back on individual control, is not released to FLD while its
-- guide rate share of the parent target is ample, and that a zero gas target
-- on the top group still stops all gas injection. The latched subgroup also
-- contains a water injector, which should not be affected by the gas controls.
--
-- Group tree:  FIELD - TOP - PRODG            (producer PROD)
--                         - INJG - SUBA       (injectors GINJA1, WINJA1)
--                                - SUBB       (injector  GINJB1, GRUP)
--                                - SUBC       (injector  GINJC1, GRUP)
--
-- SUBA, SUBB and SUBC have equal gas injection guide rates.
--
-- Phase 1 (day   0- 60): GINJA1 on BHP injects above SUBA's gas limit
--                        -> SUBA switches NONE -> RATE, GINJA1 -> GRUP.
-- Phase 2 (day  60-120): GINJA1 reset to individual RATE below SUBA's limit.
--                        SUBA's share of the TOP gas target is ample, so
--                        SUBA stays on RATE, and SUBB and SUBC share the
--                        remainder.
-- Phase 3 (day 120-200): TOP gas injection target set to 0.
--                        Expected: all gas injection stops, i.e. GINJA1
--                        switches to GRUP and SUBA is released to FLD.
--                        WINJA1 keeps injecting water.

RUNSPEC

TITLE
GCONINJE GAS SUBGROUP LATCH WITH GUIDE RATES

DIMENS
 10 10 3 /

OIL
WATER
GAS

METRIC

START
 1 JAN 2030 /

WELLDIMS
 6 3 6 6 /

TABDIMS
 1 1 20 20 /

UNIFOUT

GRID

INIT

DX
 300*100 /
DY
 300*100 /
DZ
 300*10 /
BOX
 1 10 1 10 1 1 /
TOPS
 100*2000 /
ENDBOX
PORO
 300*0.25 /
PERMX
 300*100 /
PERMY
 300*100 /
PERMZ
 300*10 /

PROPS

PVTW
 250 1.0 4.0E-5 0.5 0 /

PVDO
 100 1.10 1.0
 200 1.07 1.05
 400 1.04 1.10 /

PVDG
 100 0.0120 0.015
 200 0.0060 0.018
 300 0.0042 0.021
 400 0.0033 0.024 /

DENSITY
 850 1000 1.0 /

ROCK
 250 5.0E-5 /

SWOF
 0.20 0.00 1.00 0
 0.30 0.02 0.70 0
 0.50 0.15 0.30 0
 0.70 0.40 0.05 0
 0.80 0.60 0.00 0 /

SGOF
 0.00 0.00 1.00 0
 0.10 0.02 0.70 0
 0.30 0.15 0.30 0
 0.50 0.40 0.05 0
 0.70 0.65 0.00 0
 0.80 0.80 0.00 0 /

SOLUTION

EQUIL
 2000 250 2100 0 1900 0 /

SUMMARY

FOPR
FGIR
FWIR
FPR
GGIR
 TOP INJG SUBA SUBB SUBC /
GWIR
 TOP INJG SUBA /
GMCTG
 TOP INJG SUBA SUBB SUBC /
WGIR
 /
WWIR
 /
WMCTL
 /
WBHP
 /

SCHEDULE

RPTRST
 BASIC=2 /

GRUPTREE
 'TOP'   'FIELD' /
 'PRODG' 'TOP'   /
 'INJG'  'TOP'   /
 'SUBA'  'INJG'  /
 'SUBB'  'INJG'  /
 'SUBC'  'INJG'  /
/

WELSPECS
 'PROD'   'PRODG'  5  5 1* 'OIL'   /
 'GINJA1' 'SUBA'   1  1 1* 'GAS'   /
 'WINJA1' 'SUBA'   1  5 1* 'WATER' /
 'GINJB1' 'SUBB'   1 10 1* 'GAS'   /
 'GINJC1' 'SUBC'  10 10 1* 'GAS'   /
/

COMPDAT
 'PROD'   2* 1 3 'OPEN' 2* 0.2 /
 'GINJA1' 2* 1 1 'OPEN' 2* 0.2 /
 'WINJA1' 2* 3 3 'OPEN' 2* 0.2 /
 'GINJB1' 2* 1 1 'OPEN' 2* 0.2 /
 'GINJC1' 2* 1 1 'OPEN' 2* 0.2 /
/

WCONPROD
 'PROD' 'OPEN' 'BHP' 5* 150 /
/

GCONINJE
 'TOP'  'GAS'   'RATE' 300000 /
 'TOP'  'WATER' 'RATE' 50000 /
 'SUBA' 'GAS'   'NONE' 30000 3* 'YES' 1 'RATE' /
 'SUBB' 'GAS'   'FLD'  4*        'YES' 1 'RATE' /
 'SUBC' 'GAS'   'FLD'  4*        'YES' 1 'RATE' /
/

-- Phase 1: GINJA1 limited by BHP only -> SUBA exceeds its gas limit
WCONINJE
 'GINJA1' 'GAS'   'OPEN' 'BHP'  1000000 1* 300 /
 'WINJA1' 'WATER' 'OPEN' 'RATE'     200 1* 300 /
 'GINJB1' 'GAS'   'OPEN' 'GRUP' 1000000 1* 400 /
 'GINJC1' 'GAS'   'OPEN' 'GRUP' 1000000 1* 400 /
/

TSTEP
 6*10 /

-- Phase 2: GINJA1 back on individual rate control, below SUBA's limit
WCONINJE
 'GINJA1' 'GAS' 'OPEN' 'RATE' 15000 1* 300 /
/

TSTEP
 6*10 /

-- Phase 3: stop all gas injection via the top group target
GCONINJE
 'TOP' 'GAS' 'RATE' 0 /
/

TSTEP
 8*10 /

END
