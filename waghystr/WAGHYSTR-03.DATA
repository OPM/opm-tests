-- This test model is testing keyword WAGHYSTR. The model used here is a 1D model, dimension 1x15x1.
-- A producer is located at one end of the model (1,15,1) and one injector at the other end (1,1,1).
-- The injector is shifting between water and gas injection.

-- A total of 8 periods is injected, alternating between gas and water, starting with gas.
-- The initial water saturation (SWATINIT) is above the connate water saturation in all blocks,
-- i.e. the gas relative permeability follows three-phase (secondary) scanning curves from the start.
-- The case covers several imbibition/drainage cycles, imbibition down to the trapped gas
-- saturation and drainage starting below the trapped gas saturation.

-- Land's parameter is set to 1.5 (item 1), the secondary drainage reduction factor (item 2) is 0.0,
-- the linear fraction of the imbibition curve (item 6) is 1.0e-6 and the water saturation threshold
-- (item 7) is 0.0. The trapped saturation modification parameter (EHYSTR item 4) is set to 0.0.



------------------------------------------------------------------------------------------------
RUNSPEC
------------------------------------------------------------------------------------------------

DIMENS
 1 15 1 /

OIL
WATER
GAS
DISGAS
VAPOIL

METRIC

START
 01  'JAN' 2018 /

--
GRIDOPTS
 'YES'	      0 / 

EQLDIMS
 1 1*  25 /


WELLDIMS
-- max.well  max.con.pr.well  max.grup  max.w.pr.grup
  3	    15 	          3	     3   /

TABDIMS
--ntsfun     ntpvt  max.nssfun  max.nppvt  max.ntfip  max.nrpvt
  1          1      50          60         2         60 /

-- Relative permeability options (enable hysteresis)
SATOPTS
 HYSTER /

ENDSCALE
 /

UNIFIN
UNIFOUT

------------------------------------------------------------------------------------------------
GRID
------------------------------------------------------------------------------------------------

NEWTRAN

GRIDFILE
0  1/

INIT


INCLUDE
 'include/test1.grdecl' /

EQUALS
 'PORO' 0.22 /
 'PERMX' 200.0 /
 'PERMZ' 20.0 /
/
 
COPY
 PERMX PERMY /
/

------------------------------------------------------------------------------------------------  
EDIT
------------------------------------------------------------------------------------------------


------------------------------------------------------------------------------------------------
PROPS
------------------------------------------------------------------------------------------------

INCLUDE
 'include/norne_pvt.inc' /

ROCK
      277.0      6.11423e-05 /

INCLUDE
 'include/relperm_ow.inc' /

INCLUDE
 'include/relperm_go.inc' /


SWL
 15*0.016 /


COPY
 SWL SGU /
/

MULTIPLY
 SGU  -1.0 /
/

ADD
 SGU  1.0 /
/

TOLCRIT
  1.0e-14 /

COPY
  SWL ISWL /
  SGU ISGU /
/


SWATINIT
 5*0.05 5*0.25 5*0.35 /

EHYSTR
   1* 0 1* 0.0 KR /

WAGHYSTR
 1.5 0.0 YES NO NO 1.0e-6 0.0 / 

FILLEPS


------------------------------------------------------------------------------------------------
REGIONS
------------------------------------------------------------------------------------------------

EQUALS
 'EQLNUM' 1 /
 'PVTNUM' 1 /
 'SATNUM' 1 /
 'IMBNUM' 1 /
/
 

------------------------------------------------------------------------------------------------
SOLUTION
------------------------------------------------------------------------------------------------


RPTRST
  'BASIC=2' 'PBPD' 'KRO' 'KRW' 'KRG' /

EQUIL
-- Datum    P     woc     Pc   goc    Pc  Rsvd  Rvvd
 2020.00  268.55  2050   0.0  1550    0.0   1   1   0 /  

RSVD
 2000.0  122.30
 2010.0  122.30 /

RVVD
 2000.0  1.1E-4
 2010.0  1.1E-4 /

------------------------------------------------------------------------------------------------
SUMMARY
------------------------------------------------------------------------------------------------


INCLUDE
 'include/summary.inc' /


------------------------------------------------------------------------------------------------
SCHEDULE
------------------------------------------------------------------------------------------------

TUNING
 1* 1 /
/
/

RPTRST
 'BASIC=2' /


WELSPECS
 'PROD1'  'PROD'   1   15   1*      'OIL'    0.00      'STD'     'SHUT'      'YES'    0      'SEG' /
 'INJ_G1'  'INJ'   1    1   1*      'GAS'    0.00      'STD'     'SHUT'      'YES'    0      'SEG' /
 'INJ_W1'  'INJ'   1    1   1*      'WATER'  0.00      'STD'     'SHUT'      'YES'    0      'SEG' /
/

COMPDAT
 'PROD1'    1   15   1   1      'OPEN'   0   1*  0.216  1*   0.00	 1* 'Z' 1* /
 'INJ_G1'   1    1   1   1      'OPEN'   0   1*  0.216  1*   0.00	 1* 'Z' 1* /
 'INJ_W1'   1    1   1   1      'OPEN'   0   1*  0.216  1*   0.00	 1* 'Z' 1* /
/


-- GAS INJ 1
WCONPROD
 'PROD1' 'OPEN'  'ORAT'  250   4*  75.0 /
/

WCONINJE
 'INJ_G1' 'GAS'     'OPEN'  'RATE'   60000   1*  350.0  /
 'INJ_W1' 'WATER'   'SHUT'  'RATE'   250.0   1*  350.0  /
/

TSTEP
 10*4 /

-- WATER INJ 1
WELOPEN
 'INJ_G1' 'SHUT'  / 
 'INJ_W1' 'OPEN'  / 
/
 
TSTEP 
 10*4 /

-- GAS INJ 2
WELOPEN
 'INJ_G1' 'OPEN'  / 
 'INJ_W1' 'SHUT'  / 
/
   
TSTEP 
 20*4 /

-- WATER INJ 2
WELOPEN
 'INJ_G1' 'SHUT'  / 
 'INJ_W1' 'OPEN'  / 
/
 
TSTEP 
 5*4 /


-- GAS INJ 3
WELOPEN
 'INJ_G1' 'OPEN'  / 
 'INJ_W1' 'SHUT'  / 
/
   
TSTEP 
 40*4 /

-- WATER INJ 3
WELOPEN
 'INJ_G1' 'SHUT'  / 
 'INJ_W1' 'OPEN'  / 
/
 
TSTEP 
 8*4 /

-- GAS INJ 4
WELOPEN
 'INJ_G1' 'OPEN'  / 
 'INJ_W1' 'SHUT'  / 
/
   
TSTEP 
 80*4 /

-- WATER INJ 4
WELOPEN
 'INJ_G1' 'SHUT'  / 
 'INJ_W1' 'OPEN'  / 
/
 
TSTEP 
 80*4 /


END
 
